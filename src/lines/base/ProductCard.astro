---
import type { CatalogLine, StoreItem } from '../../features/catalog/page-catalog';
import { formatPEN } from '../../lib/shop/format';
import { fromPrice, packContents } from '../../features/store/store-filters';
import { themeStyle } from '../theme';
// Tarjeta de un producto o pack en la tienda (plantilla «base»). La imagen se puede reemplazar con el slot «visual»;
// sin él usa la primera imagen del catálogo o una muestra del color del producto.
interface Props { line: CatalogLine; item: StoreItem; }
const { line, item } = Astro.props;
const { product } = item;
const price = fromPrice(item);
const contents = packContents(item);
const isPack = product.kind === 'pack';
const cta = !product.available ? 'Explorar perfil' : isPack ? 'Ver pack' : 'Ver café';
const swatch = themeStyle({ '--swatch': product.colors.tint ?? '', '--swatch-deep': product.colors.color ?? '' });
---
<a class="store-card" href={'/producto/' + product.slug} data-product={product.slug} data-kind={product.kind} data-available={String(product.available)} style={swatch || undefined}>
  <span class="store-card-visual">
    <slot name="visual">
      {product.media[0]
        ? <img src={product.media[0].url} alt="" width="480" height="480" loading="lazy" decoding="async" />
        : <span class="store-card-swatch" aria-hidden="true"></span>}
    </slot>
  </span>
  <span class="store-card-chips">
    {!product.available && <span class="store-chip is-upcoming">Próximamente</span>}
    {isPack && <span class="store-chip is-pack">Pack</span>}
  </span>
  <span class="cb-label">{line.name}{product.num && ' · ' + product.num}</span>
  <span class="store-card-name">{product.name}</span>
  {(product.tagline || product.method) && <span class="store-card-copy">{product.tagline ?? product.method}</span>}
  {contents && <span class="store-card-contents">Incluye {contents}</span>}
  <span class="store-card-foot">
    <span class="store-card-price">
      {!product.available ? 'Precio por revelar' : price ? (price.several ? 'Desde ' : '') + formatPEN(Math.round(price.price * 100)) : 'Nuevo lote en camino'}
    </span>
    <span class="store-card-cta">{cta} <span aria-hidden="true">↗</span></span>
  </span>
</a>
<style>
  .store-card { position: relative; display: flex; flex-direction: column; gap: 10px; height: 100%; padding: 20px; border: 1px solid var(--cb-line); border-radius: 28px; background: var(--cb-cream-2); color: var(--cb-ink); text-decoration: none; transition: transform .2s ease, box-shadow .2s ease; }
  .store-card:hover { transform: translateY(-3px); box-shadow: 0 18px 40px -24px #10211b66; }
  .store-card:focus-visible { outline: 3px solid var(--cb-terracotta-bright); outline-offset: 4px; }
  .store-card-visual { display: grid; place-items: center; aspect-ratio: 1; border-radius: 20px; overflow: hidden; background: radial-gradient(70% 70% at 50% 35%, color-mix(in srgb, var(--swatch, var(--cb-terracotta-bright)) 35%, transparent), transparent 75%), var(--cb-cream-3); }
  .store-card-visual img { width: 100%; height: 100%; object-fit: cover; }
  .store-card-swatch { width: 62%; aspect-ratio: 3 / 4; border-radius: 18px; background: linear-gradient(160deg, var(--swatch, var(--cb-terracotta-bright)), var(--swatch-deep, var(--cb-forest-900))); box-shadow: 0 20px 30px -18px #10211b80; }
  .store-card-chips { position: absolute; top: 32px; left: 32px; display: flex; gap: 6px; }
  .store-card-chips:empty { display: none; }
  .store-chip { padding: 4px 10px; border-radius: 999px; font: 500 11px/1.4 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; background: var(--cb-forest-950); color: var(--cb-cream); }
  .store-chip.is-pack { background: var(--cb-terracotta-bright); color: var(--cb-ink); }
  .store-card-name { font: 500 30px/1.05 var(--font-display); letter-spacing: -.02em; }
  .store-card-copy { color: var(--cb-muted); font-size: 15px; line-height: 1.5; }
  .store-card-contents { font-size: 14px; line-height: 1.5; }
  .store-card-foot { margin-top: auto; padding-top: 12px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 8px; border-top: 1px solid var(--cb-line); }
  .store-card-price { font-weight: 600; }
  .store-card-cta { font-size: 14px; color: var(--cb-terracotta-deep); }
  @media (prefers-reduced-motion: reduce) { .store-card { transition: none; } .store-card:hover { transform: none; } }
</style>
