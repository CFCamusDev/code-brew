---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  product?: string;
  transitionName?: string;
  view?: 'front' | 'front2' | 'flat' | 'back' | 'back3d';
  scale?: number;
  locked?: boolean;
  eager?: boolean;
}
const { transitionName, product = 'hotfix', view = 'front', scale = 1, locked = false, eager = false } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('../../assets/pipeline/optimized/*.webp', { eager: true });
// Hotfix does not have a flat render: use its real front, never a synthetic bag.
const render = (width: number) => images[`../../assets/pipeline/optimized/${product}-${view}-${width}.webp`]?.default
  ?? images[`../../assets/pipeline/optimized/${product}-front-${width}.webp`]?.default;
const source = render(720);
if (!source) throw new Error(`Render de Pipeline desconocido: ${product}`);
const imageSrcset = [240, 480, 720].map(width => render(width)).filter(Boolean).map(asset => `${asset.src} ${asset.width}w`).join(', ');
const names: Record<string, string> = { hotfix: 'Hotfix', coldstart: 'Cold Start', deploy: 'Deploy', merge: 'Merge', rollback: 'Rollback' };
const views = { front: 'frente', front2: 'frente en perspectiva', flat: 'vista plana', back: 'reverso', back3d: 'reverso en perspectiva' };
const displayWidth = Math.round(240 * scale);
const imageSizes = `(max-width: 600px) ${Math.min(300, Math.round(displayWidth * .67))}px, ${displayWidth}px`;
---
<span class="cb-pouch" style={`--pouch-scale:${scale}`}>
  <Image style={transitionName ? `view-transition-name:${transitionName}` : undefined} src={import.meta.env.DEV ? source : source.src} srcset={imageSrcset} alt={`Bolsa CodeBrew ${names[product] ?? product}, ${views[view]}`} sizes={imageSizes} width={source.width} height={source.height} format="webp" decoding={eager ? 'sync' : 'async'} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} />
  {locked && <span class="cb-pouch-lock">● Próximamente</span>}
</span>
<style>
  .cb-pouch{position:relative;display:inline-block;width:calc(240px * var(--pouch-scale));max-width:100%;vertical-align:middle}
  img{display:block;width:100%;height:auto;filter:drop-shadow(0 24px 20px #0003)}
  .cb-pouch-lock{position:absolute;top:6%;left:12%;right:12%;padding:7px 10px;border:1px solid #ffffff40;border-radius:999px;background:#172c24e8;color:#f4f1e9;text-align:center;font:500 10px/1.2 'Geist Mono',monospace;letter-spacing:.12em;text-transform:uppercase}
</style>
