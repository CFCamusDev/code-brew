---
import OriginIllustration from './OriginIllustration.astro';
---

<section class="origin-section" id="origen">
  <div class="container">
    <div class="section-header">
      <span class="section-label">// 01 — origen</span>
      <h2 class="section-title">Café de altura con trazabilidad directa</h2>
      <p class="section-subtitle">
        Producido en el valle de Rodríguez de Mendoza, en el corazón de la selva alta de Amazonas.
        Trabajamos mano a mano con pequeños caficultores que seleccionan cada cereza a mano, garantizando un perfil limpio, balanceado y libre de mezclas comerciales.
      </p>
    </div>

    <div class="origin-grid">
      <!-- Tarjeta estilo ventana de editor de código (Glassmorphism Dark) -->
      <div class="editor-window" role="region" aria-label="Ficha técnica origen.json">
        <div class="editor-titlebar">
          <div class="window-controls">
            <span class="control-dot close"></span>
            <span class="control-dot min"></span>
            <span class="control-dot expand"></span>
          </div>
          <span class="editor-filename font-mono">origen.json</span>
          <div class="editor-meta">
            <button class="editor-copy-btn font-mono" id="copyOriginBtn" type="button" aria-label="Copiar datos de origen.json">
              <span id="copyOriginIcon">📋</span>
              <span id="copyOriginText">copiar</span>
            </button>
            <span class="editor-pulse-dot"></span>
            <span class="editor-status font-mono">readonly</span>
          </div>
        </div>

        <div class="editor-body">
          <pre><code><span class="syn-brace">&#123;</span>
  <span class="syn-key">"region"</span><span class="syn-colon">:</span> <span class="syn-str">"Amazonas, Perú"</span><span class="syn-comma">,</span>
  <span class="syn-key">"provincia"</span><span class="syn-colon">:</span> <span class="syn-str">"Rodríguez de Mendoza"</span><span class="syn-comma">,</span>
  <span class="syn-key">"altitud"</span><span class="syn-colon">:</span> <span class="syn-str">"1 400 – 1 800 msnm"</span><span class="syn-comma">,</span>
  <span class="syn-key">"variedades"</span><span class="syn-colon">:</span> <span class="syn-brace">[</span>
    <span class="syn-str">"Bourbon"</span><span class="syn-comma">,</span>
    <span class="syn-str">"Typica"</span><span class="syn-comma">,</span>
    <span class="syn-str">"Caturra"</span>
  <span class="syn-brace">]</span><span class="syn-comma">,</span>
  <span class="syn-key">"puntaje_SCA"</span><span class="syn-colon">:</span> <span class="syn-val">"84+"</span><span class="syn-comma">,</span>
  <span class="syn-key">"tueste"</span><span class="syn-colon">:</span> <span class="syn-str">"artesanal"</span>
<span class="syn-brace">&#125;</span></code></pre>
        </div>
      </div>

      <!-- Tarjeta Glassmorphic 3D y Topografía del Sol de Altitud -->
      <div class="origin-media">
        <OriginIllustration />
      </div>
    </div>
  </div>
</section>

<style>
  .origin-section {
    padding: clamp(56px, 8vw, 96px) 0;
    border-bottom: 1px solid var(--line);
    background-color: var(--bg);
    position: relative;
    overflow: hidden;
  }

  .section-header {
    max-width: 720px;
    margin-bottom: clamp(28px, 5vw, 44px);
  }

  .section-title {
    font-size: clamp(1.75rem, 4.5vw, 2.6rem);
    margin-bottom: 14px;
    line-height: 1.16;
  }

  .section-subtitle {
    font-size: clamp(0.95rem, 2.2vw, 1.05rem);
    line-height: 1.65;
  }

  /* Grilla completamente blindada contra scroll horizontal en mobile */
  .origin-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  /* Ventana de Editor de Código Glassmorphism Dark */
  .editor-window {
    background: rgba(20, 20, 24, 0.78);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 16px;
    overflow: hidden;
    box-shadow:
      0 18px 42px rgba(0, 0, 0, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    min-width: 0;
    max-width: 100%;
    width: 100%;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .editor-window:hover {
    border-color: rgba(200, 137, 74, 0.35);
    box-shadow:
      0 22px 50px rgba(0, 0, 0, 0.7),
      0 0 28px rgba(200, 137, 74, 0.08);
  }

  .editor-titlebar {
    background: rgba(14, 15, 18, 0.9);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    padding: 12px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    min-width: 0;
  }

  .window-controls {
    display: flex;
    gap: 7px;
    flex-shrink: 0;
  }

  .control-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }

  .control-dot.close { background-color: #E05F55; }
  .control-dot.min { background-color: #E2B340; }
  .control-dot.expand { background-color: #57C769; }

  .editor-filename {
    font-size: clamp(0.75rem, 2vw, 0.82rem);
    color: var(--text);
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    padding: 0 8px;
  }

  .editor-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .editor-pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent-2);
    box-shadow: 0 0 6px var(--accent-2);
  }

  .editor-status {
    font-size: 0.7rem;
    color: var(--muted);
    letter-spacing: 0.03em;
  }

  .editor-body {
    padding: clamp(16px, 3.5vw, 22px);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    font-family: var(--font-mono);
    font-size: clamp(0.74rem, 2.7vw, 0.88rem);
    line-height: 1.62;
    min-width: 0;
    max-width: 100%;
  }

  /* Scrollbar horizontal ultra fina estilizada para código */
  .editor-body::-webkit-scrollbar {
    height: 4px;
  }

  .editor-body::-webkit-scrollbar-track {
    background: rgba(11, 11, 12, 0.6);
  }

  .editor-body::-webkit-scrollbar-thumb {
    background: var(--line-strong);
    border-radius: 4px;
  }

  .editor-body::-webkit-scrollbar-thumb:hover {
    background: var(--accent);
  }

  /* Resaltado de sintaxis */
  .syn-brace { color: #A0A0A6; }
  .syn-colon { color: #A0A0A6; margin-right: 6px; }
  .syn-comma { color: #707076; }
  .syn-key { color: #82AAFF; } /* Azul suave dev */
  .syn-str { color: var(--accent-2); } /* Verde terminal */
  .syn-val { color: var(--accent); font-weight: 600; } /* Cobre */

  /* Contenedor de la ilustración */
  .origin-media {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    display: flex;
    align-items: stretch;
  }

  .editor-copy-btn {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--muted);
    font-size: 0.68rem;
    padding: 2px 7px;
    border-radius: 4px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: all var(--transition-fast);
  }

  .editor-copy-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: rgba(200, 137, 74, 0.12);
  }

  .editor-copy-btn.is-copied {
    color: var(--accent-2);
    border-color: var(--accent-2);
    background: rgba(127, 214, 155, 0.15);
  }

  @media (min-width: 1024px) {
    .origin-grid {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
      gap: 32px;
    }
  }
</style>

<script>
  const copyBtn = document.getElementById('copyOriginBtn');
  const copyText = document.getElementById('copyOriginText');

  const originData = {
    region: "Amazonas, Perú",
    provincia: "Rodríguez de Mendoza",
    altitud: "1 400 – 1 800 msnm",
    variedades: ["Bourbon", "Typica", "Caturra"],
    puntaje_SCA: "84+",
    tueste: "artesanal"
  };

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(JSON.stringify(originData, null, 2));
      if (copyText) copyText.textContent = '✓ copiado!';
      copyBtn.classList.add('is-copied');
      setTimeout(() => {
        if (copyText) copyText.textContent = 'copiar';
        copyBtn.classList.remove('is-copied');
      }, 2500);
    } catch (err) {
      console.error('Error al copiar:', err);
    }
  });
</script>
