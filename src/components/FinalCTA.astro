---
import { getWhatsAppUrl } from '../data/config';

const finalOrderUrl = getWhatsAppUrl('¡Hola CodeBrew! Estoy listo para pedir mi café de especialidad.');
---

<section class="final-cta-section">
  <!-- Aura ambiental radial -->
  <div class="ambient-glow ambient-glow-copper cta-glow"></div>

  <div class="container">
    <div class="cta-glass-box">
      <div class="cta-reflection"></div>

      <div class="cta-pill-tag">
        <span class="cta-pulse-dot"></span>
        <span class="font-mono">// git commit -m "refuel complete"</span>
      </div>

      <h2 class="cta-title">¿Listo para tu próximo commit?</h2>

      <p class="cta-subtitle">
        Despierta tus ideas con el café de especialidad más fresco de Rodríguez de Mendoza. Pídelo en segundos por WhatsApp y recíbelo en tu puerta.
      </p>

      <div class="cta-action">
        <a
          href={finalOrderUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary cta-btn"
          data-event="whatsapp_click"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
          Pedir por WhatsApp ahora
        </a>
      </div>

      <div class="cta-terminal-line font-mono">
        <span class="prompt">$</span> ping codebrew.pe -c 1 <span class="status-ok">-- 0% packet loss · latency &lt; 1ms</span>
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta-section {
    padding: clamp(96px, 12vw, 150px) 0 clamp(64px, 8vw, 96px);
    background-color: var(--bg);
    border-bottom: 1px solid var(--line);
    position: relative;
    overflow: hidden;
  }

  .cta-glow {
    top: 35%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 620px;
    height: 620px;
    opacity: 0.2;
  }

  .cta-glass-box {
    background: rgba(18, 19, 24, 0.85);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: clamp(36px, 6vw, 64px) clamp(20px, 4vw, 48px);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    max-width: 860px;
    margin: clamp(40px, 8vw, 80px) auto 0;
    position: relative;
    overflow: hidden;
    box-shadow:
      0 24px 60px rgba(0, 0, 0, 0.7),
      0 0 40px rgba(200, 137, 74, 0.15),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    z-index: 2;
  }

  .cta-reflection {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--metal-shine);
    pointer-events: none;
  }

  .cta-pill-tag {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.82rem;
    color: var(--accent-2);
    background: rgba(14, 15, 18, 0.75);
    border: 1px solid rgba(127, 214, 155, 0.2);
    padding: 5px 12px;
    border-radius: 20px;
  }

  .cta-pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent-2);
    box-shadow: 0 0 6px var(--accent-2);
  }

  .cta-title {
    font-size: clamp(2rem, 5vw, 3.2rem);
    color: var(--text);
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .cta-subtitle {
    font-size: clamp(1rem, 2.2vw, 1.1rem);
    max-width: 600px;
    line-height: 1.65;
    color: var(--muted);
  }

  .cta-action {
    margin-top: 6px;
    width: 100%;
    max-width: 340px;
  }

  .cta-btn {
    width: 100%;
    padding: 14px 28px;
    font-size: 1rem;
  }

  .cta-terminal-line {
    font-size: clamp(0.72rem, 2vw, 0.8rem);
    color: var(--muted);
    margin-top: 8px;
  }

  .prompt {
    color: var(--accent-2);
    margin-right: 4px;
  }

  .status-ok {
    color: var(--accent-2);
  }
</style>
