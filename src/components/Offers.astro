---
import { getWhatsAppUrl } from '../data/config';

// Texto y datos de la promoción vigente (fácilmente editable)
const currentPromo = {
  command: '> oferta --activa --target=developer-pack',
  badge: 'PROMO COMMIT #01',
  title: 'Pack Developer Dúo (2 × 250 g) con Envío Preferencial',
  description: 'Llévate dos bolsas de 250 g de café de especialidad (Monteverde + Espresso Amazonas) por solo S/ 62 y accede a tarifa plana o envío preferencial en tu primer pedido.',
  ctaText: 'Reclamar oferta por WhatsApp',
  promoMessage: '¡Hola CodeBrew! Quiero reclamar la oferta activa del Pack Developer (2x250g por S/ 62).'
};

const promoUrl = getWhatsAppUrl(currentPromo.promoMessage);
---

<section class="offers-section" id="ofertas">
  <div class="container">
    <div class="terminal-card">
      <div class="terminal-header">
        <div class="terminal-controls">
          <span class="term-dot"></span>
          <span class="term-dot"></span>
          <span class="term-dot"></span>
        </div>
        <div class="terminal-title font-mono">{currentPromo.command}</div>
        <div class="terminal-badge font-mono">{currentPromo.badge}</div>
      </div>

      <div class="terminal-body">
        <div class="terminal-content">
          <span class="terminal-prompt font-mono">$ deploy --promo</span>
          <h3 class="promo-heading">{currentPromo.title}</h3>
          <p class="promo-copy">{currentPromo.description}</p>
        </div>

        <div class="terminal-action">
          <a
            href={promoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary promo-btn"
            data-event="whatsapp_click"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
            {currentPromo.ctaText}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .offers-section {
    padding: 64px 0;
    background-color: var(--bg-2);
    border-bottom: 1px solid var(--line);
  }

  .terminal-card {
    background-color: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.5);
  }

  .terminal-header {
    background-color: #111113;
    padding: 12px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
    flex-wrap: wrap;
    gap: 12px;
  }

  .terminal-controls {
    display: flex;
    gap: 6px;
  }

  .term-dot {
    width: 9px;
    height: 9px;
    background-color: #38383E;
    border-radius: 50%;
  }

  .terminal-title {
    font-size: 0.8rem;
    color: var(--accent-2);
    word-break: break-word;
    min-width: 0;
  }

  .terminal-badge {
    font-size: 0.72rem;
    color: var(--accent);
    background-color: rgba(200, 137, 74, 0.12);
    border: 1px solid rgba(200, 137, 74, 0.3);
    padding: 2px 8px;
    border-radius: 4px;
  }

  .terminal-body {
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .terminal-prompt {
    font-size: 0.85rem;
    color: var(--muted);
    display: block;
    margin-bottom: 10px;
  }

  .promo-heading {
    font-size: clamp(1.4rem, 3.5vw, 2rem);
    color: var(--text);
    margin-bottom: 10px;
  }

  .promo-copy {
    font-size: 1rem;
    line-height: 1.6;
    max-width: 720px;
  }

  .terminal-action {
    display: flex;
    align-items: center;
  }

  .promo-btn {
    width: 100%;
  }

  @media (min-width: 640px) {
    .promo-btn {
      width: auto;
    }
  }

  @media (min-width: 1024px) {
    .terminal-body {
      padding: 40px 36px;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }

    .terminal-action {
      flex-shrink: 0;
    }
  }
</style>
