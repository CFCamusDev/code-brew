---
import { getWhatsAppUrl } from '../data/config';

// Texto y datos de la promoción vigente (fácilmente editable)
const currentPromo = {
  command: '> oferta --activa --target=developer-pack',
  badge: 'PROMO COMMIT #01',
  title: 'Pack Developer Dúo (2 × 250 g) con Envío Preferencial',
  description: 'Llévate dos bolsas de 250 g de café de especialidad (Monteverde + Espresso Amazonas) por solo S/ 62 y accede a tarifa plana o envío preferencial en tu primer pedido.',
  ctaText: 'Reclamar oferta por WhatsApp',
  promoMessage: '¡Hola CodeBrew! Quiero reclamar la oferta activa del Pack Developer (2x250g por S/ 62).'
};

const promoUrl = getWhatsAppUrl(currentPromo.promoMessage);
---

<section class="offers-section" id="ofertas">
  <div class="container">
    <div class="terminal-glass-card" data-reveal="scale">
      <div class="terminal-reflection"></div>

      <div class="terminal-header">
        <div class="terminal-controls">
          <span class="term-dot close"></span>
          <span class="term-dot min"></span>
          <span class="term-dot expand"></span>
        </div>
        <div class="terminal-title font-mono">{currentPromo.command}</div>
        <div class="terminal-badge font-mono">{currentPromo.badge}</div>
      </div>

      <div class="terminal-body">
        <div class="terminal-content">
          <div class="terminal-prompt-row font-mono">
            <span class="prompt-sign">$</span>
            <span class="prompt-text">deploy --promo --auto-claim</span>
            <span class="cursor-blink">▍</span>
          </div>

          <h3 class="promo-heading">{currentPromo.title}</h3>
          <p class="promo-copy">{currentPromo.description}</p>
        </div>

        <div class="terminal-action">
          <a
            href={promoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary promo-btn"
            data-event="whatsapp_click"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1 8 8v.5z"></path>
            </svg>
            {currentPromo.ctaText}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .offers-section {
    padding: clamp(56px, 7vw, 84px) 0;
    background-color: var(--bg-2);
    border-bottom: 1px solid var(--line);
    position: relative;
    overflow: hidden;
  }

  .terminal-glass-card {
    background: rgba(18, 19, 24, 0.82);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 16px;
    overflow: hidden;
    box-shadow:
      0 20px 48px rgba(0, 0, 0, 0.65),
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 0 32px rgba(200, 137, 74, 0.1);
    position: relative;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .terminal-glass-card:hover {
    border-color: rgba(200, 137, 74, 0.35);
    box-shadow:
      0 26px 56px rgba(0, 0, 0, 0.75),
      0 0 40px rgba(200, 137, 74, 0.15);
  }

  .terminal-reflection {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--metal-shine);
    pointer-events: none;
  }

  .terminal-header {
    background: rgba(12, 13, 16, 0.9);
    backdrop-filter: blur(10px);
    padding: 12px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    flex-wrap: wrap;
    gap: 12px;
  }

  .terminal-controls {
    display: flex;
    gap: 7px;
  }

  .term-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }

  .term-dot.close { background-color: #E05F55; }
  .term-dot.min { background-color: #E2B340; }
  .term-dot.expand { background-color: #57C769; }

  .terminal-title {
    font-size: 0.8rem;
    color: var(--accent-2);
    word-break: break-word;
    min-width: 0;
  }

  .terminal-badge {
    font-size: 0.72rem;
    color: var(--accent);
    background-color: rgba(200, 137, 74, 0.14);
    border: 1px solid rgba(200, 137, 74, 0.32);
    padding: 2px 8px;
    border-radius: 4px;
    font-weight: 700;
  }

  .terminal-body {
    padding: clamp(24px, 5vw, 40px) clamp(18px, 4vw, 36px);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .terminal-prompt-row {
    font-size: 0.84rem;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 12px;
  }

  .prompt-sign {
    color: var(--accent-2);
  }

  .promo-heading {
    font-size: clamp(1.4rem, 3.5vw, 2rem);
    color: var(--text);
    margin-bottom: 10px;
    line-height: 1.2;
  }

  .promo-copy {
    font-size: 1rem;
    line-height: 1.65;
    max-width: 720px;
    color: var(--muted);
  }

  .terminal-action {
    display: flex;
    align-items: center;
  }

  .promo-btn {
    width: 100%;
    padding: 13px 26px;
    font-size: 0.95rem;
  }

  @media (min-width: 640px) {
    .promo-btn {
      width: auto;
    }
  }

  @media (min-width: 1024px) {
    .terminal-body {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }

    .terminal-action {
      flex-shrink: 0;
    }
  }
</style>
