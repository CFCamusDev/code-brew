<script>
  function initScrollExperience() {
    // 1. Scroll Reveal con IntersectionObserver
    const revealElements = document.querySelectorAll('[data-reveal]');
    
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const delay = el.dataset.revealDelay ? parseInt(el.dataset.revealDelay) : 0;
          
          setTimeout(() => {
            el.classList.add('is-revealed');
          }, delay);

          // Si el elemento contiene barras de progreso
          const progressBars = el.querySelectorAll('[data-progress-bar]');
          progressBars.forEach((bar) => {
            const barEl = bar as HTMLElement;
            const target = barEl.dataset.progressBar || '0';
            setTimeout(() => {
              barEl.style.width = `${target}%`;
            }, delay + 200);
          });

          // Si el elemento contiene contadores numéricos
          const counters = el.querySelectorAll('[data-counter]');
          counters.forEach((cnt) => {
            animateCounter(cnt as HTMLElement);
          });

          // Ya no necesitamos observarlo
          revealObserver.unobserve(el);
        }
      });
    }, {
      threshold: 0.15,
      rootMargin: '0px 0px -40px 0px'
    });

    revealElements.forEach((el) => revealObserver.observe(el));

    // 2. Animador de Contadores Numéricos
    function animateCounter(el: HTMLElement) {
      if (el.dataset.counterAnimated === 'true') return;
      el.dataset.counterAnimated = 'true';

      const target = parseFloat(el.dataset.counter || '0');
      const prefix = el.dataset.counterPrefix || '';
      const suffix = el.dataset.counterSuffix || '';
      const duration = 1400; // ms
      const startTime = performance.now();

      function update(now: number) {
        const elapsed = now - startTime;
        const progress = Math.min(1, elapsed / duration);
        // Easing out cubic
        const ease = 1 - Math.pow(1 - progress, 3);
        const current = Math.round(target * ease);

        el.textContent = `${prefix}${current.toLocaleString()}${suffix}`;

        if (progress < 1) {
          requestAnimationFrame(update);
        } else {
          el.textContent = `${prefix}${target.toLocaleString()}${suffix}`;
        }
      }

      requestAnimationFrame(update);
    }

    // 3. Tilt 3D Magnético Interactivo en Tarjetas Glass (Desktop)
    const isTouch = 'ontouchstart' in window || navigator.maxTouchPoints > 0;
    if (!isTouch && window.innerWidth >= 1024) {
      const tiltCards = document.querySelectorAll<HTMLElement>('.product-card, .feature-glass-card, .editor-window, .step-glass-card, .terminal-glass-card');
      
      tiltCards.forEach((card) => {
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          
          const centerX = rect.width / 2;
          const centerY = rect.height / 2;
          
          const rotateX = ((y - centerY) / centerY) * -6; // Max 6 deg
          const rotateY = ((x - centerX) / centerX) * 6;

          card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-4px)`;
        });

        card.addEventListener('mouseleave', () => {
          card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) translateY(0px)';
        });
      });
    }

    // 4. Efecto de Escritura de Código en origen.json
    const originPre = document.querySelector('.editor-body pre code');
    if (originPre) {
      const originObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('code-typing-active');
            originObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.3 });
      originObserver.observe(originPre);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScrollExperience);
  } else {
    initScrollExperience();
  }
</script>

<style is:global>
  /* Clases de animación por scroll (Reveal Engine) */
  [data-reveal] {
    opacity: 0;
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.8s cubic-bezier(0.16, 1, 0.3, 1),
                filter 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform, filter;
  }

  [data-reveal="up"] {
    transform: translateY(32px);
    filter: blur(6px);
  }

  [data-reveal="down"] {
    transform: translateY(-24px);
    filter: blur(4px);
  }

  [data-reveal="left"] {
    transform: translateX(-36px);
    filter: blur(6px);
  }

  [data-reveal="right"] {
    transform: translateX(36px);
    filter: blur(6px);
  }

  [data-reveal="scale"] {
    transform: scale(0.92);
    filter: blur(6px);
  }

  /* Estado activado cuando entra al scroll */
  [data-reveal].is-revealed {
    opacity: 1;
    transform: translate(0) scale(1);
    filter: blur(0);
  }

  /* Transición suave para tilt 3D */
  .product-card,
  .feature-glass-card,
  .editor-window,
  .step-glass-card,
  .terminal-glass-card {
    transition: transform 0.22s cubic-bezier(0.2, 0.8, 0.2, 1),
                box-shadow 0.25s ease,
                border-color 0.25s ease !important;
    transform-style: preserve-3d;
  }

  /* Barras de telemetría reactivas */
  .telemetry-fill {
    transition: width 1.3s cubic-bezier(0.16, 1, 0.3, 1) !important;
  }

  /* Resaltado de código al entrar */
  .code-typing-active {
    animation: codeGlowIn 1.2s ease forwards;
  }

  @keyframes codeGlowIn {
    0% {
      opacity: 0.2;
      filter: brightness(0.6);
    }
    100% {
      opacity: 1;
      filter: brightness(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
      transition: none !important;
    }
  }
</style>
