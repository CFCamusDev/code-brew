---
interface Props {
  size?: number;
}

const { size = 28 } = Astro.props;
---

<svg
  class="logo-mark"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <!-- Vapor -->
  <path class="logo-mark-steam" d="M9 2.5c0 1-1 1-1 2s1 1 1 2" />
  <path class="logo-mark-steam" d="M12.5 2c0 1-1 1-1 2s1 1 1 2" />
  <!-- Taza -->
  <path d="M4.5 9.5h12v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4z" />
  <path d="M16.5 11h1.2a2.3 2.3 0 0 1 0 4.6h-1.2" />
  <line x1="3.5" y1="19.5" x2="17.5" y2="19.5" />
  <!-- Llaves de código -->
  <path class="logo-mark-accent" d="M9 12.2l-1.3 1.6L9 15.4" />
  <path class="logo-mark-accent" d="M12 12.2l1.3 1.6L12 15.4" />
</svg>

<style>
  .logo-mark {
    color: var(--text);
    flex-shrink: 0;
  }

  .logo-mark-accent {
    color: var(--accent);
  }

  .logo-mark-steam {
    color: var(--accent-2);
    opacity: 0.85;
  }
</style>
