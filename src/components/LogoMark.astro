---
interface Props {
  size?: number;
  light?: boolean;
}
const { size = 28, light = false } = Astro.props;
---
<img
  class="logo-mark"
  src={light ? '/assets/brand/codebrew-cup-light.webp' : '/assets/brand/codebrew-cup.webp'}
  width={size}
  height={size}
  alt=""
  aria-hidden="true"
/>
<style>
  .logo-mark {
    display: block;
    object-fit: contain;
    flex-shrink: 0;
  }
</style>
