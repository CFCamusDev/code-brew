---
import Pouch from './Pouch.astro';
---
<section id="top" class="cb-hero" aria-labelledby="hero-title">
 <div class="cb-wrap cb-hero-grid">
  <div class="cb-hero-copy">
   <span class="cb-glass cb-status"><i class="cb-live"></i>PIPELINE 01 · HOTFIX YA DISPONIBLE</span>
   <h1 id="hero-title">Buen café.<br />Mejor <em>código.</em></h1>
   <p><span class="cb-desktop-copy">Café de especialidad peruano, tostado de forma artesanal para quienes convierten una idea en algo real. De Amazonas a tu escritorio.</span><span class="cb-mobile-copy">Café de especialidad peruano para quienes convierten una idea en algo real.</span></p>
   <div class="cb-actions"><a href="/producto/hotfix" class="cb-btn cb-accent">Comprar Hotfix ↗</a><a href="#pipeline" class="cb-btn cb-glass">Explorar el Pipeline</a></div>
   <dl class="cb-hero-facts"><div><dt>100%</dt><dd>ARÁBICA</dd></div><div><dt>Lavado</dt><dd>PROCESO</dd></div><div><dt>1 500–1 600</dt><dd>M S. N. M.</dd></div></dl>
  </div>
  <div class="cb-hero-stage">
   <span class="cb-orbit" aria-hidden="true"></span>
   <div class="cb-hero-bag cb-hero-left cb-float"><Pouch product="coldstart" view="front2" locked scale={1.05} /></div>
   <div class="cb-hero-bag cb-hero-right cb-float"><Pouch product="deploy" locked scale={1} /></div>
   <div class="cb-hero-bag cb-hero-main cb-float"><Pouch product="hotfix" scale={1.5} eager /></div>
   <span class="cb-bean cb-bean-one" aria-hidden="true"></span><span class="cb-bean cb-bean-two" aria-hidden="true"></span>
   <span class="cb-glass cb-hotspot cb-hotspot-one"><i></i>Dulzor a chancaca</span>
   <div class="cb-glass cb-release"><span class="cb-label">PIPELINE</span><p><b>01</b> de 05 lanzado</p><div aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div></div>
  </div>
 </div>
</section>
