---
import { Image } from 'astro:assets';
import { getWhatsAppUrl } from '../data/config';
import heroBag from '../assets/products/bag-dark.png';

const heroOrderUrl = getWhatsAppUrl('¡Hola CodeBrew! Vengo desde su web y quiero pedir café de especialidad.');
---

<section class="hero-section" id="hero">
  <div class="container hero-container">
    <!-- Columna de Texto -->
    <div class="hero-content">
      <div class="code-tag hero-tag">
        <span>// café de especialidad · Amazonas, Perú</span>
      </div>

      <h1 class="hero-title">
        Café que despierta ideas<span class="cursor-blink">▍</span>
      </h1>

      <p class="hero-description">
        Granos de altura (1 400 – 1 800 msnm) cultivados en Rodríguez de Mendoza, Amazonas.
        Tostado artesanal de precisión para desarrolladores y mentes analíticas que buscan un café sin atajos.
      </p>

      <div class="hero-actions">
        <a
          href={heroOrderUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
          data-event="whatsapp_click"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
          Pedir por WhatsApp
        </a>

        <a href="#productos" class="btn btn-metal">
          Ver productos
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>

      <div class="hero-footnote">
        <span class="font-mono text-muted">// tu código necesita café</span>
      </div>
    </div>

    <!-- Columna de Imagen -->
    <div class="hero-media">
      <div class="img-slot hero-img-slot has-image" id="img-hero">
        <Image
          src={heroBag}
          alt="Bolsa de café de especialidad CodeBrew sobre superficie oscura"
          width={720}
          height={900}
          priority
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: 48px;
    padding-bottom: 56px;
    border-bottom: 1px solid var(--line);
    position: relative;
    overflow: hidden;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .hero-tag {
    align-self: flex-start;
  }

  .hero-title {
    font-size: clamp(2.2rem, 7vw, 3.8rem);
    line-height: 1.08;
    color: var(--text);
    font-weight: 700;
  }

  .hero-description {
    font-size: clamp(1rem, 2.5vw, 1.15rem);
    line-height: 1.6;
    max-width: 580px;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 8px;
  }

  .hero-footnote {
    margin-top: 4px;
    font-size: 0.88rem;
  }

  .text-muted {
    color: var(--muted);
  }

  /* Imagen Hero */
  .hero-media {
    width: 100%;
  }

  .hero-img-slot {
    aspect-ratio: 4 / 5;
    min-height: 320px;
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.45);
  }

  .hero-img-slot.has-image {
    padding: 0;
    border-style: solid;
    border-color: var(--line);
  }

  .hero-img-slot.has-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 640px) {
    .hero-actions {
      flex-direction: row;
      align-items: center;
    }
  }

  @media (min-width: 1024px) {
    .hero-section {
      padding-top: 84px;
      padding-bottom: 96px;
    }

    .hero-container {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      align-items: center;
      gap: 48px;
    }

    .hero-img-slot {
      aspect-ratio: 1 / 1;
      min-height: 440px;
    }
  }
</style>
