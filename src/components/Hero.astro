---
import { getWhatsAppUrl } from '../data/config';
import CoffeeBag3D from './CoffeeBag3D.astro';

const heroOrderUrl = getWhatsAppUrl('¡Hola CodeBrew! Vengo desde su web y quiero pedir café de especialidad.');
---

<section class="hero-section" id="hero">
  <!-- Auras ambientales de fondo (negro mate vibrante) -->
  <div class="ambient-glow ambient-glow-copper hero-glow-1"></div>
  <div class="ambient-glow ambient-glow-terminal hero-glow-2"></div>

  <div class="container hero-container">
    <!-- Columna de Texto -->
    <div class="hero-content">
      <div class="hero-pill-badge">
        <span class="pill-dot"></span>
        <span class="pill-text font-mono">// café de especialidad · Amazonas, Perú</span>
        <span class="pill-tag font-mono">84+ SCA</span>
      </div>

      <h1 class="hero-title">
        Café que despierta ideas<span class="cursor-blink">▍</span>
      </h1>

      <p class="hero-description">
        Granos de altura (1 400 – 1 800 msnm) cultivados en Rodríguez de Mendoza, Amazonas.
        Tostado artesanal de precisión para desarrolladores y mentes analíticas que buscan un café sin atajos.
      </p>

      <div class="hero-actions">
        <a
          href={heroOrderUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary hero-btn-primary"
          data-event="whatsapp_click"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
          Pedir por WhatsApp
        </a>

        <a href="#productos" class="btn btn-metal hero-btn-secondary">
          Ver productos
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>

      <div class="hero-specs-row">
        <div class="hero-spec-item font-mono">
          <span class="spec-label">STATUS</span>
          <span class="spec-value">200 OK · Envíos activos</span>
        </div>
        <div class="hero-spec-sep"></div>
        <div class="hero-spec-item font-mono">
          <span class="spec-label">MOLIENDA</span>
          <span class="spec-value">Grano o Molido a medida</span>
        </div>
      </div>
    </div>

    <!-- Columna Multimedia 3D Interactiva con Three.js -->
    <div class="hero-media">
      <CoffeeBag3D />
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: clamp(40px, 7vw, 84px);
    padding-bottom: clamp(48px, 8vw, 96px);
    border-bottom: 1px solid var(--line);
    position: relative;
    overflow: hidden;
    background-color: var(--bg);
  }

  /* Auras ambientales de fondo */
  .hero-glow-1 {
    top: -120px;
    left: 20%;
    width: 480px;
    height: 480px;
  }

  .hero-glow-2 {
    bottom: -100px;
    right: 5%;
    width: 420px;
    height: 420px;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    gap: 36px;
    position: relative;
    z-index: 1;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* Pill badge superior estilo glass */
  .hero-pill-badge {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 24px;
    background: rgba(18, 19, 23, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.09);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
    max-width: 100%;
    flex-wrap: wrap;
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent-2);
    box-shadow: 0 0 8px var(--accent-2);
    animation: pulseDot 2s infinite;
  }

  @keyframes pulseDot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .pill-text {
    font-size: clamp(0.74rem, 2.2vw, 0.82rem);
    color: var(--text);
  }

  .pill-tag {
    font-size: 0.7rem;
    color: var(--accent);
    background: rgba(200, 137, 74, 0.15);
    border: 1px solid rgba(200, 137, 74, 0.3);
    padding: 2px 7px;
    border-radius: 12px;
    font-weight: 700;
  }

  .hero-title {
    font-size: clamp(2.2rem, 6.8vw, 3.8rem);
    line-height: 1.08;
    color: var(--text);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .hero-description {
    font-size: clamp(1rem, 2.3vw, 1.15rem);
    line-height: 1.65;
    max-width: 580px;
    color: var(--muted);
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 6px;
  }

  .hero-btn-primary {
    padding: 13px 26px;
    font-size: 0.95rem;
  }

  .hero-btn-secondary {
    padding: 13px 24px;
    font-size: 0.95rem;
  }

  .hero-specs-row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-top: 10px;
    flex-wrap: wrap;
  }

  .hero-spec-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.76rem;
  }

  .spec-label {
    color: var(--accent-2);
    background: rgba(127, 214, 155, 0.1);
    border: 1px solid rgba(127, 214, 155, 0.2);
    padding: 1px 6px;
    border-radius: 4px;
    font-size: 0.68rem;
  }

  .spec-value {
    color: var(--muted);
  }

  .hero-spec-sep {
    width: 1px;
    height: 14px;
    background: var(--line-strong);
  }

  .hero-media {
    width: 100%;
    min-width: 0;
    display: flex;
    justify-content: center;
  }

  @media (min-width: 640px) {
    .hero-actions {
      flex-direction: row;
      align-items: center;
    }
  }

  @media (min-width: 1024px) {
    .hero-container {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      align-items: center;
      gap: 48px;
    }
  }
</style>
