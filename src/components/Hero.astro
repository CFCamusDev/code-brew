---
import { getWhatsAppUrl } from '../data/config';

const heroOrderUrl = getWhatsAppUrl('¡Hola CodeBrew! Vengo desde su web y quiero pedir café de especialidad.');
---

<section class="hero-section" id="hero">
  <!-- Auras ambientales de fondo -->
  <div class="ambient-glow ambient-glow-copper hero-glow-1"></div>
  <div class="ambient-glow ambient-glow-terminal hero-glow-2"></div>

  <div class="container hero-container">
    <!-- Columna de Texto -->
    <div class="hero-content">
      <div class="hero-pill-badge" data-reveal="up">
        <span class="pill-dot"></span>
        <span class="pill-text font-mono">// café de especialidad · Amazonas, Perú</span>
        <span class="pill-tag font-mono">84+ SCA</span>
      </div>

      <h1 class="hero-title" data-reveal="up" data-reveal-delay="100">
        Café que despierta ideas<span class="cursor-blink">▍</span>
      </h1>

      <p class="hero-description" data-reveal="up" data-reveal-delay="180">
        Granos de altura (1 400 – 1 800 msnm) cultivados en Rodríguez de Mendoza, Amazonas.
        Tostado artesanal de precisión para desarrolladores y mentes analíticas que buscan un café sin atajos.
      </p>

      <div class="hero-actions" data-reveal="up" data-reveal-delay="260">
        <a
          href={heroOrderUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary hero-btn-primary"
          data-event="whatsapp_click"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
          Pedir por WhatsApp
        </a>

        <a href="#productos" class="btn btn-metal hero-btn-secondary">
          Ver productos
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>

      <div class="hero-specs-row" data-reveal="up" data-reveal-delay="340">
        <div class="hero-spec-item font-mono">
          <span class="spec-label">STATUS</span>
          <span class="spec-value">200 OK · Envíos activos</span>
        </div>
        <div class="hero-spec-sep"></div>
        <div class="hero-spec-item font-mono">
          <span class="spec-label">MOLIENDA</span>
          <span class="spec-value">Grano o Molido a medida</span>
        </div>
      </div>
    </div>

    <!-- Columna Marco 3D Holográfico -->
    <div class="hero-media" data-reveal="scale" data-reveal-delay="180">
      <div class="hero-hologram-frame">
        <div class="holo-shine"></div>

        <div class="holo-hud-top">
          <div class="holo-chip">
            <span class="holo-pulse"></span>
            <span class="font-mono holo-text">THREE.JS CINEMATIC · SCROLL DRIVEN</span>
          </div>
          <span class="holo-badge font-mono">SCA 84.5</span>
        </div>

        <!-- Área transparente donde la gran bolsa 3D se ubica -->
        <div class="holo-portal-view">
          <div class="portal-crosshair cross-tl"></div>
          <div class="portal-crosshair cross-tr"></div>
          <div class="portal-crosshair cross-bl"></div>
          <div class="portal-crosshair cross-br"></div>
          
          <div class="portal-hint font-mono">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 5v14M19 12l-7 7-7-7"/>
            </svg>
            <span>Desplaza hacia abajo para navegar en 3D</span>
          </div>
        </div>

        <div class="holo-hud-bottom">
          <div class="holo-origin-meta font-mono">
            <span class="origin-label">// lote_origen</span>
            <span class="origin-name">Rodríguez de Mendoza · 1 800 msnm</span>
          </div>
          <span class="holo-tag font-mono">ARÁBICA PURO</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: clamp(40px, 7vw, 84px);
    padding-bottom: clamp(48px, 8vw, 96px);
    border-bottom: 1px solid var(--line);
    position: relative;
    overflow: hidden;
    background-color: transparent;
  }

  .hero-glow-1 {
    top: -120px;
    left: 20%;
    width: 480px;
    height: 480px;
  }

  .hero-glow-2 {
    bottom: -100px;
    right: 5%;
    width: 420px;
    height: 420px;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    gap: 36px;
    position: relative;
    z-index: 2;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .hero-pill-badge {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 24px;
    background: rgba(18, 19, 23, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.09);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
    max-width: 100%;
    flex-wrap: wrap;
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent-2);
    box-shadow: 0 0 8px var(--accent-2);
    animation: pulseDot 2s infinite;
  }

  @keyframes pulseDot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .pill-text {
    font-size: clamp(0.74rem, 2.2vw, 0.82rem);
    color: var(--text);
  }

  .pill-tag {
    font-size: 0.7rem;
    color: var(--accent);
    background: rgba(200, 137, 74, 0.15);
    border: 1px solid rgba(200, 137, 74, 0.3);
    padding: 2px 7px;
    border-radius: 12px;
    font-weight: 700;
  }

  .hero-title {
    font-size: clamp(2.2rem, 6.8vw, 3.8rem);
    line-height: 1.08;
    color: var(--text);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .hero-description {
    font-size: clamp(1rem, 2.3vw, 1.15rem);
    line-height: 1.65;
    max-width: 580px;
    color: var(--muted);
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 6px;
  }

  .hero-btn-primary {
    padding: 13px 26px;
    font-size: 0.95rem;
  }

  .hero-btn-secondary {
    padding: 13px 24px;
    font-size: 0.95rem;
  }

  .hero-specs-row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-top: 10px;
    flex-wrap: wrap;
  }

  .hero-spec-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.76rem;
  }

  .spec-label {
    color: var(--accent-2);
    background: rgba(127, 214, 155, 0.1);
    border: 1px solid rgba(127, 214, 155, 0.2);
    padding: 1px 6px;
    border-radius: 4px;
    font-size: 0.68rem;
  }

  .spec-value {
    color: var(--muted);
  }

  .hero-spec-sep {
    width: 1px;
    height: 14px;
    background: var(--line-strong);
  }

  /* Marco Holográfico 3D */
  .hero-media {
    width: 100%;
    min-width: 0;
    display: flex;
    justify-content: center;
  }

  .hero-hologram-frame {
    position: relative;
    width: 100%;
    max-width: 480px;
    aspect-ratio: 4 / 5;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow:
      0 20px 50px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .holo-shine {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--metal-shine);
    pointer-events: none;
  }

  .holo-hud-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    z-index: 2;
  }

  .holo-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 12px;
    border-radius: 20px;
    background: rgba(12, 13, 16, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .holo-pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent-2);
    box-shadow: 0 0 6px var(--accent-2);
  }

  .holo-text {
    font-size: 0.68rem;
    color: var(--text);
    letter-spacing: 0.04em;
  }

  .holo-badge {
    font-size: 0.72rem;
    color: var(--accent);
    padding: 3px 9px;
    border-radius: 6px;
    background: rgba(200, 137, 74, 0.14);
    border: 1px solid rgba(200, 137, 74, 0.3);
    font-weight: 700;
  }

  .holo-portal-view {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 12px;
  }

  .portal-crosshair {
    position: absolute;
    width: 10px;
    height: 10px;
    border-color: rgba(200, 137, 74, 0.4);
    border-style: solid;
  }

  .cross-tl { top: 10px; left: 10px; border-width: 2px 0 0 2px; }
  .cross-tr { top: 10px; right: 10px; border-width: 2px 2px 0 0; }
  .cross-bl { bottom: 10px; left: 10px; border-width: 0 0 2px 2px; }
  .cross-br { bottom: 10px; right: 10px; border-width: 0 2px 2px 0; }

  .portal-hint {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.72rem;
    color: var(--accent-2);
    background: rgba(14, 15, 18, 0.82);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(127, 214, 155, 0.25);
    padding: 6px 14px;
    border-radius: 20px;
    animation: hintBounce 2.5s infinite;
  }

  @keyframes hintBounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-4px); }
  }

  .holo-hud-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    z-index: 2;
    background: rgba(12, 13, 16, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 8px 14px;
  }

  .holo-origin-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .origin-label {
    font-size: 0.65rem;
    color: var(--accent-2);
  }

  .origin-name {
    font-size: 0.74rem;
    color: var(--text);
  }

  .holo-tag {
    font-size: 0.68rem;
    color: var(--accent);
    font-weight: 700;
  }

  @media (min-width: 640px) {
    .hero-actions {
      flex-direction: row;
      align-items: center;
    }
  }

  @media (min-width: 1024px) {
    .hero-container {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      align-items: center;
      gap: 48px;
    }

    .hero-hologram-frame {
      aspect-ratio: 1 / 1;
      max-width: 480px;
    }
  }
</style>
