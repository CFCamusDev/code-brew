---
import WorldStage from './WorldStage.astro';
import BotanicalMark from './BotanicalMark.astro';
---
<section class="hero-chapter" aria-labelledby="hero-title">
  <div class="hero-sticky">
    <div class="hero immersive-hero">
      <div class="hero-copy">
        <p class="eyebrow"><span class="tiny-star"><BotanicalMark /></span> SPECIALTY COFFEE / DEVELOPER SPIRIT</p>
        <h1 id="hero-title">Buen café.<br />Mejor<br /><span class="serif-word">código.</span><span class="hero-asterisk" aria-hidden="true"><BotanicalMark /></span></h1>
        <p class="hero-description">De Amazonas a tu escritorio. Café de especialidad para quienes convierten una idea en algo real.</p>
        <div class="hero-actions"><a href="#productos" class="button primary">Encuentra tu blend <span aria-hidden="true">↗</span></a><a href="#origen" class="text-link">Explora el origen <span aria-hidden="true">↓</span></a></div>
        <div class="hero-footnote"><span class="status-dot"></span> Origen peruano. Espíritu developer.</div>
      </div>
      <WorldStage kind="hero" label="Bolsa de café CodeBrew en una escena 3D con granos flotantes" />
      <div class="hero-bottom"><span>SCROLL TO BREW <span aria-hidden="true">↓</span></span><div class="chapter-track"><i></i></div><span class="chapter-status">01 / THE DAILY RITUAL</span></div>
    </div>
  </div>
</section>
<div class="quality-strip"><span>100% arábica</span><i><BotanicalMark kind="bean" /></i><span>Origen peruano</span><i><BotanicalMark /></i><span>Tueste artesanal</span><i><BotanicalMark kind="bean" /></i><span>Built for your daily ritual</span></div>
