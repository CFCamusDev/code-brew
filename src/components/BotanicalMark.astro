---
interface Props { kind?: 'leaf' | 'bean' }
const { kind = 'leaf' } = Astro.props;
---
<svg class="botanical-mark" viewBox="0 0 48 48" fill="none" aria-hidden="true">
  {kind === 'leaf' ? <>
    <path d="M8 36C3 17 20 7 40 6C42 26 29 42 8 36Z" fill="currentColor" />
    <path d="M6 42L33 14M16 31L14 22M23 24L32 25" stroke="var(--cream)" stroke-width="2" stroke-linecap="round" />
  </> : <>
    <ellipse cx="24" cy="24" rx="15" ry="21" transform="rotate(32 24 24)" fill="currentColor" />
    <path d="M33 7C15 17 32 29 15 41" stroke="var(--cream)" stroke-width="2.5" stroke-linecap="round" />
  </>}
</svg>
<style>
  .botanical-mark { width: .85em; height: .85em; display: inline-block; vertical-align: middle; }
</style>
