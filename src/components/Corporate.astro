---
import { Image } from 'astro:assets';
import { getWhatsAppUrl } from '../data/config';
import corporateImage from '../assets/brand/workspace-hero.webp';

const corporateUrl = getWhatsAppUrl('¡Hola CodeBrew! Quisiera cotizar café para nuestra empresa / equipo de desarrollo.');
---

<section class="corporate-section" id="empresas">
  <div class="container">
    <div class="corporate-glass-card">
      <div class="corporate-shine"></div>

      <div class="corporate-content">
        <div class="corporate-tag font-mono">// empresas & onboarding</div>
        <h2 class="corporate-title">Café de especialidad para tu equipo tech</h2>
        <p class="corporate-desc">
          Abastece la barra de café de tu oficina o sorprende a tus ingenieros con packs de bienvenida y regalos corporativos personalizados. Envíos programados mensuales con facturación y soporte directo.
        </p>

        <div class="corporate-perks">
          <div class="perk-pill font-mono">
            <span class="perk-dot"></span> Facturación B2B
          </div>
          <div class="perk-pill font-mono">
            <span class="perk-dot"></span> Despacho Mensual Programado
          </div>
          <div class="perk-pill font-mono">
            <span class="perk-dot"></span> Merchandising Personalizado
          </div>
        </div>

        <div class="corporate-cta">
          <a
            href={corporateUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-metal"
            data-event="whatsapp_click"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
              <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
            </svg>
            Cotizar plan corporativo
          </a>
        </div>
      </div>

      <!-- Imagen Corporativo (16:9) con marco Glass -->
      <div class="corporate-media">
        <div class="img-slot corporate-img-slot has-image" id="img-corporativo">
          <Image
            src={corporateImage}
            alt="Espacio de trabajo de desarrollador con laptop y café de especialidad CodeBrew"
            width={960}
            height={540}
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .corporate-section {
    padding: clamp(64px, 8vw, 96px) 0;
    background-color: var(--bg-2);
    border-bottom: 1px solid var(--line);
    position: relative;
    overflow: hidden;
  }

  .corporate-glass-card {
    background: rgba(20, 21, 26, 0.78);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 20px;
    padding: clamp(24px, 5vw, 44px);
    display: flex;
    flex-direction: column;
    gap: 32px;
    position: relative;
    overflow: hidden;
    box-shadow: 0 16px 44px rgba(0, 0, 0, 0.55);
  }

  .corporate-shine {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--metal-shine);
    pointer-events: none;
  }

  .corporate-content {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }

  .corporate-tag {
    font-size: 0.82rem;
    color: var(--accent-2);
  }

  .corporate-title {
    font-size: clamp(1.6rem, 3.5vw, 2.3rem);
    color: var(--text);
    line-height: 1.2;
  }

  .corporate-desc {
    font-size: 1rem;
    line-height: 1.65;
    max-width: 650px;
    color: var(--muted);
  }

  .corporate-perks {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 4px;
  }

  .perk-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.74rem;
    color: var(--text);
    background: rgba(14, 15, 18, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 4px 10px;
    border-radius: 20px;
  }

  .perk-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: var(--accent);
  }

  .corporate-cta {
    margin-top: 8px;
  }

  .corporate-media {
    width: 100%;
    min-width: 0;
  }

  .corporate-img-slot {
    aspect-ratio: 16 / 9;
    min-height: 220px;
    border-radius: 14px;
    overflow: hidden;
  }

  .corporate-img-slot.has-image {
    padding: 0;
    border-style: solid;
    border-color: rgba(255, 255, 255, 0.08);
    background: #0E0F12;
  }

  .corporate-img-slot.has-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 1024px) {
    .corporate-glass-card {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      align-items: center;
      gap: 40px;
    }
  }
</style>
