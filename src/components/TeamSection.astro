---
import WorldStage from './WorldStage.astro';
import { getWhatsAppUrl } from '../data/config';

// Para equipos: isla oscura con los empaques en 3D, una tarjeta de código y tres formas de llevar el café a la empresa.
// Las ofertas repiten lo que la tienda ya promete (oficina, sprint, welcome pack); los detalles se coordinan por WhatsApp.
const offers = [
  {
    tag: 'office.daily()',
    title: 'Café para la oficina',
    text: 'Café de especialidad para el día a día del equipo, en grano o molido según la cafetera que tengan.',
    cta: 'Cotizar para la oficina',
    message: '¡Hola CodeBrew! Quisiera café para la oficina. Somos ___ personas y usamos ___ (cafetera / método).'
  },
  {
    tag: 'onboarding.welcome()',
    title: 'Welcome pack',
    text: 'Una bolsa o el Pack Developer para dar la bienvenida a quienes se suman al equipo.',
    cta: 'Armar un welcome pack',
    message: '¡Hola CodeBrew! Quisiera armar welcome packs para nuevos integrantes del equipo.'
  },
  {
    tag: 'sprint.release()',
    title: 'Sprints y eventos',
    text: 'Para hackathons, demo days y offsites. Coordinamos contigo cantidades, molienda y entrega.',
    cta: 'Planear un evento',
    message: '¡Hola CodeBrew! Quisiera café para un evento de nuestro equipo (hackathon, demo day u offsite).'
  }
];
const steps = [
  ['01', 'Nos cuentas cuántos son y qué buscan.'],
  ['02', 'Te proponemos cafés, presentaciones y molienda.'],
  ['03', 'Coordinamos la entrega contigo.']
];
---
<section id="empresas" class="team-section" aria-labelledby="team-title">
  <WorldStage kind="team" label="Empaques Codebrew Hotfix: frente y reverso en 3D" />

  <div class="team-copy">
    <p class="eyebrow">Para equipos que construyen</p>
    <h2 id="team-title">El mejor perk.<br /><span class="serif-word">Un buen café.</span></h2>
    <p class="team-lede">Para la oficina, el próximo sprint o ese welcome pack. Hagamos del café un ritual que tu equipo quiera compartir.</p>
    <div class="team-actions">
      <a class="button cream" href={getWhatsAppUrl('¡Hola CodeBrew! Me interesa café para mi equipo. Quisiera coordinar una propuesta para oficina o regalos.')} target="_blank" rel="noopener noreferrer">Hablemos de tu equipo <span aria-hidden="true">↗</span></a>
      <a class="text-link" href="#team-offers">Ver opciones <span aria-hidden="true">↓</span></a>
    </div>
    <ol class="team-steps" aria-label="Cómo funciona">
      {steps.map(([number, text]) => <li><b>{number}</b>{text}</li>)}
    </ol>
  </div>

  <pre class="team-code" aria-hidden="true"><span class="c">// perk.ts</span>
<span class="k">const</span> equipo = {'{'}
  personas: <span class="n">12</span>,
  ritual: <span class="s">'cada mañana'</span>,
  molienda: <span class="s">'espresso'</span>,
{'}'};
<span class="f">codebrew</span>.<span class="f">propuesta</span>(equipo); <span class="c">// hablemos ↗</span></pre>

  <div class="team-offers" id="team-offers">
    {offers.map(offer => (
      <article class="team-offer">
        <span class="tag">{offer.tag}</span>
        <h3>{offer.title}</h3>
        <p>{offer.text}</p>
        <a href={getWhatsAppUrl(offer.message)} target="_blank" rel="noopener noreferrer">{offer.cta} <span aria-hidden="true">↗</span></a>
      </article>
    ))}
  </div>
</section>
