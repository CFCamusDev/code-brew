---
import { Image } from 'astro:assets';
import hotfix from '../assets/brand/hotfix-daily-driver.webp';
import hotfixRight from '../assets/brand/hotfix-daily-driver-right.webp';
const demoImages: Record<string, typeof hotfix> = {hotfix};
import { PRODUCTS, getWhatsAppBaseUrl, getWhatsAppUrl } from '../data/config';
import catalog from '../data/catalog.json';
import { getLiveCatalog } from '../lib/server/shop';
// Precios, moliendas y stock en vivo desde la base de datos (catalog.json si no responde).
const live = await getLiveCatalog();
const grindsOf=(slug:string)=>live?.grinds.get(slug) ?? catalog.products.find(p=>p.slug===slug)!.grinds;
const priceOf=(sku:string,fallback:number)=>live?.variants.get(sku)?.price ?? fallback;
const availableOf=(sku:string)=>live ? live.variants.get(sku)?.available ?? false : true;
const profiles = [
 {id:'monteverde',name:'Hotfix',tag:'01 / PIPELINE · STABLE',description:'Espresso de Rodríguez de Mendoza, Amazonas. Cuerpo alto, dulzor a chancaca y un final limpio de cacao. Hay bugs que no esperan al próximo sprint: para esos, existe un hotfix.',roast:'Tueste medio-oscuro',color:'#254b38',image:'hotfix',ids:['monteverde-250','monteverde-500'],grinds:grindsOf('monteverde')},
];
const upcoming = ['02', '03', '04'].map(number => ({ id: `pipeline-${number}`, number }));
---
<section id="productos" class="blend-section section">
  <div class="section-heading" data-reveal><div><p class="eyebrow">01 / CHOOSE YOUR DAILY DRIVER</p><h2>Encuentra tu<br /><span class="serif-word">match perfecto.</span></h2></div><p>Un origen. Distintas formas de disfrutarlo.<br />El siguiente movimiento lo eliges tú.</p></div>
  <div class="blend-experience">
    <div class="blend-panels">
      {await Promise.all(profiles.map(async(profile,index)=>{
        const variants=profile.ids.map(id=>{const p=PRODUCTS.find(p=>p.id===id)!;return {...p,price:priceOf(p.id,p.price),available:availableOf(p.id)};});
        const first=variants.find(v=>v.available)??variants[0];
        return <article id={`blend-${profile.id}`} class:list={['blend-panel',{'is-selected':index===0}]} data-profile={profile.id} data-product={profile.name} style={`--blend-color:${profile.color}`} hidden={index!==0}>
          <div class="blend-info"><p class="eyebrow">{profile.tag}</p><h3>{profile.name}</h3><div class="blend-price-row"><span class="product-price">S/ {first.price.toFixed(2)}</span><span class="blend-roast">{profile.roast}</span></div><p class="blend-description">{profile.description}</p><div class="blend-specs"><span>AMAZONAS, PERÚ</span><span>100% ARÁBICA</span></div>{profile.id==='monteverde'&&<dl class="blend-origin-facts"><div><dt>Proceso</dt><dd>Lavado</dd></div><div><dt>Altitud</dt><dd>1 500–1 600 m s. n. m.</dd></div><div class="blend-fact-wide"><dt>Variedades</dt><dd>Caturra, Catuaí y Geisha</dd></div><div class="blend-fact-wide"><dt>Preparación</dt><dd>Espresso · Cafetera tradicional · AeroPress</dd></div></dl>}<div class="product-options"><label>Presentación<select class="variant-select" aria-label={`Presentación de ${profile.name}`}>{variants.map(v=><option value={v.format} data-price={v.price} data-sku={v.id} data-available={String(v.available)} selected={v===first}>{v.format}</option>)}</select></label><label>Molienda<select class="grind-select" aria-label={`Molienda de ${profile.name}`}>{profile.grinds.map(g=><option>{g}</option>)}</select></label></div><p class="reserve-note" hidden={first.available}><span class="reserve-dot" aria-hidden="true"></span>Nuevo lote en camino · Resérvalo y te avisamos apenas esté listo.</p><button type="button" class:list={['button primary order-link add-to-cart',{'is-reserve':!first.available}]}>{first.available?'Este es mi café ':'Reservar mi café '}<span aria-hidden="true">{first.available?'+':'→'}</span></button><a class="order-alt whatsapp-order" target="_blank" rel="noopener noreferrer" href={await getWhatsAppUrl(`¡Hola CodeBrew! Quiero pedir ${profile.name} (${first.format}), ${profile.grinds[0]}, por S/ ${first.price}. ¿Me confirman disponibilidad y envío?`)}>o pídelo por WhatsApp ↗</a></div>
          <div class:list={['blend-visual',{'is-pair':profile.id==='developer'}]}><div class="blend-disc"></div><Image class="blend-cutout" src={demoImages[profile.image]} alt={profile.id==='monteverde'?'Hotfix 250 g: frente crema con etiqueta verde y lateral verde de métodos de preparación':`Empaque conceptual de ${profile.name}`} width={profile.id==='monteverde'?1000:768} height={profile.id==='monteverde'?1333:1152} format="webp" loading="lazy" />{profile.id==='monteverde'&&<><Image class="blend-cutout blend-side" src={hotfixRight} alt="Hotfix 250 g: frente crema con etiqueta verde y lateral crema con el mensaje Good coffee. Better ideas." width={1000} height={1333} format="webp" loading="lazy" hidden /><button type="button" class="blend-turn" aria-pressed="false" aria-label="Ver el otro lado del empaque"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></button></>}<span class="blend-caption">DISEÑADO PARA TU RITUAL DIARIO</span></div>
        </article>;
      }))}
      {upcoming.map(profile => <article id={`blend-${profile.id}`} class="blend-panel pipeline-preview" data-profile={profile.id} style="--blend-color:#647260" hidden>
        <div class="blend-info pipeline-info">
          <p class="eyebrow">{profile.number} / PIPELINE · EN DESARROLLO</p>
          <span class="pipeline-status"><span aria-hidden="true"></span>PRÓXIMO LANZAMIENTO</span>
          <h3>Lo bueno<br />se está <span class="serif-word">preparando.</span></h3>
          <p class="blend-description">Un nuevo perfil de la línea Pipeline está tomando forma. Por ahora, guardamos la sorpresa.</p>
          <div class="pipeline-redacted" aria-hidden="true"><span></span><span></span><span></span></div>
          <p class="pipeline-soon">Muy pronto<span aria-hidden="true"> ↗</span></p>
          <p class="pipeline-footnote">El nombre, el perfil y los detalles se revelarán en su lanzamiento.</p>
        </div>
        <div class="blend-visual pipeline-visual" aria-label="Próximo café de la línea Pipeline, aún sin revelar">
          <div class="blend-disc"></div>
          <div class="pipeline-silhouette" aria-hidden="true"><span></span></div>
          <div class="pipeline-seal" aria-hidden="true"><span>PIPELINE / {profile.number}</span><strong>Muy pronto.</strong><small>UN NUEVO RITUAL EN CAMINO</small></div>
          <span class="blend-caption">EL SIGUIENTE COMMIT TODAVÍA SE ESTÁ PREPARANDO</span>
        </div>
      </article>)}
    </div>
    <div class="blend-selector" role="group" aria-label="Elige tu perfil de café">
      {profiles.map((profile,index)=><button class:list={['blend-choice',{'is-active':index===0}]} data-select={profile.id} aria-pressed={index===0?'true':'false'} aria-controls={`blend-${profile.id}`} style={`--blend-color:${profile.color}`}><span class="choice-image"><Image src={demoImages[profile.image]} alt="" width={120} height={profile.id==='monteverde'?160:180} format="webp" loading="lazy" /></span><span><small>0{index+1}</small>Hotfix</span><b aria-hidden="true">↗</b></button>)}
      {upcoming.map(profile => <button class="blend-choice pipeline-choice" data-select={profile.id} aria-pressed="false" aria-controls={`blend-${profile.id}`} aria-label={`Pipeline ${profile.number}: muy pronto`} style="--blend-color:#647260"><span class="choice-image pipeline-choice-image" aria-hidden="true"><span></span></span><span><small>PIPELINE / {profile.number}</small>Muy pronto</span><b aria-hidden="true">◌</b></button>)}
    </div>
  </div>
  <p class="catalog-note">Hotfix ya es parte de tu ritual. Los próximos perfiles de Pipeline se revelarán muy pronto.</p>
  <noscript><p>También puedes <a href={await getWhatsAppUrl()}>consultar todos los perfiles y formatos por WhatsApp</a>.</p></noscript>
  <!-- Reserva por WhatsApp para las presentaciones sin stock: arma el mensaje con los datos del cliente. -->
  <dialog class="reserve-dialog" aria-labelledby="reserve-title" data-whatsapp={await getWhatsAppBaseUrl()}>
    <form class="reserve-form" novalidate>
      <button type="button" class="reserve-close" aria-label="Cerrar">×</button>
      <p class="eyebrow">NUEVO LOTE EN CAMINO</p>
      <h3 id="reserve-title">Reserva tu café</h3>
      <p class="reserve-intro">Estamos empacando el próximo lote. Déjanos tus datos y te escribimos por WhatsApp apenas esté listo. No pagas nada ahora.</p>
      <p class="reserve-item"></p>
      <div class="reserve-fields">
        <label>Cantidad<input name="qty" type="number" min="1" max="10" value="1" inputmode="numeric" required /></label>
        <label>Celular<input name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="9XX XXX XXX" required /></label>
        <label class="reserve-wide">Nombre<input name="name" autocomplete="name" maxlength="60" required /></label>
        <label class="reserve-wide">Distrito o ciudad<input name="place" autocomplete="address-level2" maxlength="60" placeholder="Ej. Miraflores, Lima" required /></label>
        <label class="reserve-wide"><span>Comentario <small>(opcional)</small></span><textarea name="note" rows="2" maxlength="200"></textarea></label>
      </div>
      <p class="reserve-error" role="alert" hidden></p>
      <button type="submit" class="button primary">Enviar reserva por WhatsApp <span aria-hidden="true">↗</span></button>
      <p class="reserve-fine">Se abrirá WhatsApp con tu mensaje listo; solo tienes que enviarlo.</p>
    </form>
  </dialog>
</section>
<script>
  import { gsap } from 'gsap';
  import { track } from '../lib/analytics';
  import { addToCart, cartOpen } from '../lib/shop/cart';
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const choices = document.querySelectorAll<HTMLButtonElement>('.blend-choice');
  const panels = document.querySelectorAll<HTMLElement>('.blend-panel');
  let swap: gsap.core.Timeline | null = null;
  // Hotfix: la flecha gira la bolsa sobre su eje para mostrar el otro lateral; al pulsarla de nuevo vuelve al frente.
  const turnButton = document.querySelector<HTMLButtonElement>('.blend-turn');
  let turn: gsap.core.Timeline | null = null;
  const sides = () => [...turnButton!.closest('.blend-visual')!.querySelectorAll<HTMLImageElement>('.blend-cutout')];
  const setSide = (other: boolean) => {
    const [front, back] = sides();
    front.hidden = other; back.hidden = !other;
    turnButton!.setAttribute('aria-pressed', String(other));
    turnButton!.setAttribute('aria-label', other ? 'Ver el frente del empaque' : 'Ver el otro lado del empaque');
  };
  turnButton?.addEventListener('click', () => {
    const other = turnButton.getAttribute('aria-pressed') !== 'true';
    turn?.progress(1).kill();
    if(reduced.matches || document.documentElement.classList.contains('motion-paused')) { setSide(other); return; }
    const [front, back] = sides();
    const [shown, next] = other ? [front, back] : [back, front];
    const dir = other ? 1 : -1;
    // La gota se encoge en un lado y reaparece en el otro con un pequeño rebote.
    turn = gsap.timeline()
      .set(turnButton, { transition: 'none' })
      .to(shown, { rotationY: -90 * dir, duration: .28, ease: 'power2.in' })
      .to(turnButton, { scale: .3, opacity: 0, duration: .24, ease: 'power2.in' }, 0)
      .add(() => { setSide(other); gsap.set(shown, { clearProps: 'transform' }); })
      .fromTo(next, { rotationY: 90 * dir }, { rotationY: 0, duration: .5, ease: 'power3.out', clearProps: 'transform' })
      .fromTo(turnButton, { scale: .3, opacity: 0 }, { scale: 1, opacity: 1, duration: .7, ease: 'elastic.out(1,.5)', clearProps: 'transform,opacity,transition' }, '<.08');
  });
  // 3D swap: the current bag turns away on its Y axis, the next one turns in from the opposite side.
  choices.forEach((choice, index) => choice.addEventListener('click', () => {
    const panel = document.getElementById(`blend-${choice.dataset.select}`);
    if(!panel || choice.getAttribute('aria-pressed') === 'true') return;
    const current = [...panels].find(p => !p.hidden);
    const from = [...choices].findIndex(c => c.getAttribute('aria-pressed') === 'true');
    const dir = index > from ? 1 : -1;
    choices.forEach(button => { const active = button === choice; button.classList.toggle('is-active', active); button.setAttribute('aria-pressed', String(active)); });
    swap?.progress(1).kill();
    const show = () => { panels.forEach(p => { p.hidden = p !== panel; }); if(turnButton?.closest<HTMLElement>('.blend-panel')?.hidden) { turn?.progress(1).kill(); setSide(false); } };
    if(reduced.matches || document.documentElement.classList.contains('motion-paused') || !current) { show(); return; }
    const parts = (p: HTMLElement) => ({ cut: p.querySelectorAll('.blend-cutout,.pipeline-silhouette'), info: p.querySelector('.blend-info'), disc: p.querySelector('.blend-disc') });
    const out = parts(current), inn = parts(panel);
    // Developer Dúo bags rest tilted via CSS (±10deg); tween into that tilt so clearing props doesn't jump.
    const tilt = (_: number, el: Element) => !el.closest('.is-pair') ? 0 : el.classList.contains('second-cutout') ? 10 : -10;
    swap = gsap.timeline({ defaults: { overwrite: 'auto' } })
      .fromTo(out.cut, { rotation: tilt }, { rotation: 0, rotationY: -75 * dir, x: -60 * dir, z: -220, opacity: 0, duration: .38, ease: 'power2.in', stagger: .04 })
      .to(out.info, { opacity: 0, x: -24 * dir, duration: .3, ease: 'power2.in' }, 0)
      .to(out.disc, { scale: .8, rotationX: 55, opacity: .4, duration: .38, ease: 'power2.in' }, 0)
      .add(() => { show(); gsap.set([out.cut, out.info, out.disc], { clearProps: 'all' }); })
      .fromTo(inn.disc, { scale: .8, rotationX: -55, opacity: .4 }, { scale: 1, rotationX: 0, opacity: 1, duration: .7, ease: 'power3.out' })
      .fromTo(inn.cut, { rotation: 0, rotationY: 75 * dir, x: 60 * dir, z: -220, opacity: 0 }, { rotation: tilt, rotationY: 0, x: 0, z: 0, opacity: 1, duration: .8, ease: 'power3.out', stagger: .08, clearProps: 'transform' }, '<')
      .fromTo(inn.info, { opacity: 0, x: 24 * dir }, { opacity: 1, x: 0, duration: .5, ease: 'power2.out', clearProps: 'transform' }, '<.1');
  }));
  document.querySelectorAll<HTMLElement>('.blend-panel[data-product]').forEach(card=>{
    const variant=card.querySelector<HTMLSelectElement>('.variant-select')!;
    const grind=card.querySelector<HTMLSelectElement>('.grind-select')!;
    const link=card.querySelector<HTMLAnchorElement>('.whatsapp-order')!;
    const add=card.querySelector<HTMLButtonElement>('.add-to-cart')!;
    const note=card.querySelector<HTMLElement>('.reserve-note')!;
    const update=()=>{const available=variant.selectedOptions[0].dataset.available!=='false';add.classList.toggle('is-reserve',!available);note.hidden=available;add.firstChild!.textContent=available?'Este es mi café ':'Reservar mi café ';add.querySelector('span')!.textContent=available?'+':'→';const price=Number(variant.selectedOptions[0].dataset.price);card.querySelector('.product-price')!.textContent=`S/ ${price.toFixed(2)}`;const url=new URL(link.href);url.searchParams.set('text',`¡Hola CodeBrew! Quiero pedir ${card.dataset.product} (${variant.value}), ${grind.value}, por S/ ${price}. ¿Me confirman disponibilidad y envío?`);link.href=url.toString();};
    const view = () => {
      const option = variant.selectedOptions[0];
      track('view_item', {value:Number(option.dataset.price),items:[{item_id:option.dataset.sku!,item_name:card.dataset.product!,price:Number(option.dataset.price),quantity:1}]});
    };
    let seen = '';
    const observer = new IntersectionObserver(entries => {
      if(entries.some(e=>e.isIntersecting) && !card.hidden && seen !== variant.value) { seen=variant.value; view(); }
    }, {threshold:.4});
    observer.observe(card);
    variant.addEventListener('change',()=>{if(!card.hidden){seen=variant.value;view();}});
    variant.addEventListener('change',update);grind.addEventListener('change',update);
    add.addEventListener('click',()=>{
      const option=variant.selectedOptions[0];
      if(option.dataset.available==='false') return openReserve({product:card.dataset.product!,format:variant.value,grind:grind.value,price:Number(option.dataset.price)});
      addToCart(option.dataset.sku!,grind.value,1,Number(option.dataset.price));cartOpen.set(true);
    });
  });

  // Reserva por WhatsApp: mientras llega el nuevo lote, el cliente deja sus datos y se abre el chat con el mensaje listo.
  const reserveDialog=document.querySelector<HTMLDialogElement>('.reserve-dialog')!;
  const reserveForm=reserveDialog.querySelector<HTMLFormElement>('form')!;
  const reserveError=reserveDialog.querySelector<HTMLElement>('.reserve-error')!;
  let reserving={product:'',format:'',grind:'',price:0};
  function openReserve(item: typeof reserving){
    reserving=item;
    reserveDialog.querySelector('.reserve-item')!.textContent=`${item.product} · ${item.format} · ${item.grind} · S/ ${item.price.toFixed(2)} c/u`;
    reserveError.hidden=true;
    reserveDialog.showModal();
  }
  reserveDialog.querySelector('.reserve-close')!.addEventListener('click',()=>reserveDialog.close());
  // Un clic fuera de la tarjeta (sobre el fondo) también la cierra.
  reserveDialog.addEventListener('click',event=>{if(event.target===reserveDialog)reserveDialog.close();});
  reserveForm.addEventListener('submit',event=>{
    event.preventDefault();
    const data=new FormData(reserveForm);
    const value=(key:string)=>String(data.get(key)??'').trim();
    const qty=Number(value('qty'));
    // Celular peruano: 9 dígitos que empiezan con 9 (se aceptan espacios y el prefijo 51).
    const phone=value('phone').replace(/\D/g,'').replace(/^51(?=9\d{8}$)/,'');
    const problem=!Number.isInteger(qty)||qty<1||qty>10?'La cantidad debe ser de 1 a 10 bolsas.'
      :!/^9\d{8}$/.test(phone)?'Escribe un celular de 9 dígitos que empiece con 9.'
      :value('name').length<2?'Escribe tu nombre.'
      :value('place').length<2?'Escribe tu distrito o ciudad.':'';
    reserveError.textContent=problem;reserveError.hidden=!problem;
    if(problem) return;
    const lines=[
      '¡Hola CodeBrew! Quiero reservar mi café del nuevo lote:',
      `• ${qty} × ${reserving.product} ${reserving.format}, ${reserving.grind} (S/ ${reserving.price.toFixed(2)} c/u)`,
      `• Nombre: ${value('name')}`,
      `• Celular: ${phone}`,
      `• Entrega en: ${value('place')}`,
      ...(value('note')?[`• Comentario: ${value('note')}`]:[]),
      'Avísenme apenas esté listo. ¡Gracias!'
    ];
    window.open(`${reserveDialog.dataset.whatsapp}?text=${encodeURIComponent(lines.join('\n'))}`,'_blank','noopener');
    reserveForm.querySelector<HTMLTextAreaElement>('textarea')!.value='';
    reserveDialog.close();
  });
</script>
