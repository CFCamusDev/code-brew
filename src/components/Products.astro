---
import { Image } from 'astro:assets';
import monteverde from '../assets/demo/monteverde.png';
import espresso from '../assets/demo/espresso.png';
import microlote from '../assets/demo/microlote.png';
import hotfix from '../assets/brand/hotfix-daily-driver.webp';
import hotfixRight from '../assets/brand/hotfix-daily-driver-right.webp';
const demoImages: Record<string, typeof monteverde> = {monteverde, espresso, microlote, hotfix};
import { PRODUCTS, getWhatsAppUrl } from '../data/config';
import catalog from '../data/catalog.json';
import { getLiveCatalog } from '../lib/server/shop';
// Precios, moliendas y stock en vivo desde la base de datos (catalog.json si no responde).
const live = await getLiveCatalog();
const grindsOf=(slug:string)=>live?.grinds.get(slug) ?? catalog.products.find(p=>p.slug===slug)!.grinds;
const priceOf=(sku:string,fallback:number)=>live?.variants.get(sku)?.price ?? fallback;
const availableOf=(sku:string)=>live ? live.variants.get(sku)?.available ?? false : true;
const profiles = [
 {id:'monteverde',name:'Hotfix',tag:'01 / PIPELINE · STABLE',description:'Espresso de Rodríguez de Mendoza, Amazonas. Cuerpo alto, dulzor a chancaca y un final limpio de cacao. Hay bugs que no esperan al próximo sprint: para esos, existe un hotfix.',roast:'Tueste medio-oscuro',color:'#254b38',image:'hotfix',ids:['monteverde-250','monteverde-500'],grinds:grindsOf('monteverde')},
 {id:'espresso',name:'Espresso Amazonas',tag:'02 / MODO INTENSO',description:'Un perfil de tueste medio-oscuro para quienes disfrutan un café con más carácter. Tu siguiente ritual empieza aquí.',roast:'Tueste medio-oscuro',color:'#a65c3d',image:'espresso',ids:['espresso-250','espresso-500'],grinds:grindsOf('espresso')},
 {id:'developer',name:'Pack Developer',tag:'03 / MEJOR EN PAREJA',description:'Monteverde + Espresso Amazonas. Dos bolsas, dos perfiles y una buena excusa para descubrir tu favorito o compartir con tu pair.',roast:'Dos perfiles de tueste',color:'#b89350',image:'monteverde',ids:['pack-developer'],grinds:grindsOf('developer')},
 {id:'microlote',name:'Microlote de Temporada',tag:'04 / EXPLORA ALGO NUEVO',description:'Un tueste claro para salir de la rutina y acercarte al origen desde otra perspectiva. Consulta el lote disponible.',roast:'Tueste claro',color:'#727d9b',image:'microlote',ids:['microlote-temporada'],grinds:grindsOf('microlote')}
];
---
<section id="productos" class="blend-section section">
  <div class="section-heading" data-reveal><div><p class="eyebrow">01 / CHOOSE YOUR DAILY DRIVER</p><h2>Encuentra tu<br /><span class="serif-word">match perfecto.</span></h2></div><p>Un origen. Distintas formas de disfrutarlo.<br />El siguiente movimiento lo eliges tú.</p></div>
  <div class="blend-experience">
    <div class="blend-panels">
      {profiles.map((profile,index)=>{
        const variants=profile.ids.map(id=>{const p=PRODUCTS.find(p=>p.id===id)!;return {...p,price:priceOf(p.id,p.price),available:availableOf(p.id)};});
        const first=variants.find(v=>v.available)??variants[0];
        return <article id={`blend-${profile.id}`} class:list={['blend-panel',{'is-selected':index===0}]} data-profile={profile.id} data-product={profile.name} style={`--blend-color:${profile.color}`} hidden={index!==0}>
          <div class="blend-info"><p class="eyebrow">{profile.tag}</p><h3>{profile.name}</h3><div class="blend-price-row"><span class="product-price">S/ {first.price.toFixed(2)}</span><span class="blend-roast">{profile.roast}</span></div><p class="blend-description">{profile.description}</p><div class="blend-specs"><span>AMAZONAS, PERÚ</span><span>100% ARÁBICA</span></div>{profile.id==='monteverde'&&<dl class="blend-origin-facts"><div><dt>Proceso</dt><dd>Lavado</dd></div><div><dt>Altitud</dt><dd>1 500–1 600 m s. n. m.</dd></div><div class="blend-fact-wide"><dt>Variedades</dt><dd>Caturra, Catuaí y Geisha</dd></div><div class="blend-fact-wide"><dt>Preparación</dt><dd>Espresso · Cafetera tradicional · AeroPress</dd></div></dl>}<div class="product-options"><label>Presentación<select class="variant-select" aria-label={`Presentación de ${profile.name}`}>{variants.map(v=><option value={v.format} data-price={v.price} data-sku={v.id} data-available={String(v.available)} selected={v===first}>{v.available?v.format:`${v.format} · agotado`}</option>)}</select></label><label>Molienda<select class="grind-select" aria-label={`Molienda de ${profile.name}`}>{profile.grinds.map(g=><option>{g}</option>)}</select></label></div><button type="button" class="button primary order-link add-to-cart" disabled={!first.available}>{first.available?'Este es mi café ':'Agotado por ahora '}<span aria-hidden="true">{first.available?'+':''}</span></button><a class="order-alt whatsapp-order" target="_blank" rel="noopener noreferrer" href={getWhatsAppUrl(`¡Hola CodeBrew! Quiero pedir ${profile.name} (${first.format}), ${profile.grinds[0]}, por S/ ${first.price}. ¿Me confirman disponibilidad y envío?`)}>o pídelo por WhatsApp ↗</a></div>
          <div class:list={['blend-visual',{'is-pair':profile.id==='developer'}]}><div class="blend-disc"></div><Image class="blend-cutout" src={demoImages[profile.image]} alt={profile.id==='monteverde'?'Hotfix 250 g: frente crema con etiqueta verde y lateral verde de métodos de preparación':`Empaque conceptual de ${profile.name}`} width={profile.id==='monteverde'?1000:768} height={profile.id==='monteverde'?1333:1152} format="webp" loading="lazy" />{profile.id==='monteverde'&&<><Image class="blend-cutout blend-side" src={hotfixRight} alt="Hotfix 250 g: frente crema con etiqueta verde y lateral crema con el mensaje Good coffee. Better ideas." width={1000} height={1333} format="webp" loading="lazy" hidden /><button type="button" class="blend-turn" aria-pressed="false" aria-label="Ver el otro lado del empaque"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></button></>}{profile.id==='developer'&&<Image class="blend-cutout second-cutout" src={espresso} alt="Segundo empaque conceptual del Pack Developer" width="1024" height="1536" loading="lazy" />}<span class="blend-caption">DISEÑADO PARA TU RITUAL DIARIO</span></div>
        </article>;
      })}
    </div>
    <div class="blend-selector" role="group" aria-label="Elige tu perfil de café">
      {profiles.map((profile,index)=><button class:list={['blend-choice',{'is-active':index===0}]} data-select={profile.id} aria-pressed={index===0?'true':'false'} aria-controls={`blend-${profile.id}`} style={`--blend-color:${profile.color}`}><span class="choice-image"><Image src={demoImages[profile.image]} alt="" width={120} height={profile.id==='monteverde'?160:180} format="webp" loading="lazy" /></span><span><small>0{index+1}</small>{profile.id==='developer'?'Developer Dúo':profile.id==='microlote'?'Microlote':profile.id==='espresso'?'Espresso':'Hotfix'}</span><b aria-hidden="true">↗</b></button>)}
    </div>
  </div>
  <p class="catalog-note">Empaques conceptuales de muestra. Arma tu pedido en línea o, si prefieres, coordínalo por WhatsApp.</p>
  <noscript><p>También puedes <a href={getWhatsAppUrl()}>consultar todos los perfiles y formatos por WhatsApp</a>.</p></noscript>
</section>
<script>
  import { gsap } from 'gsap';
  import { track } from '../lib/analytics';
  import { addToCart, cartOpen } from '../lib/shop/cart';
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const choices = document.querySelectorAll<HTMLButtonElement>('.blend-choice');
  const panels = document.querySelectorAll<HTMLElement>('.blend-panel');
  let swap: gsap.core.Timeline | null = null;
  // Hotfix: la flecha gira la bolsa sobre su eje para mostrar el otro lateral; al pulsarla de nuevo vuelve al frente.
  const turnButton = document.querySelector<HTMLButtonElement>('.blend-turn');
  let turn: gsap.core.Timeline | null = null;
  const sides = () => [...turnButton!.closest('.blend-visual')!.querySelectorAll<HTMLImageElement>('.blend-cutout')];
  const setSide = (other: boolean) => {
    const [front, back] = sides();
    front.hidden = other; back.hidden = !other;
    turnButton!.setAttribute('aria-pressed', String(other));
    turnButton!.setAttribute('aria-label', other ? 'Ver el frente del empaque' : 'Ver el otro lado del empaque');
  };
  turnButton?.addEventListener('click', () => {
    const other = turnButton.getAttribute('aria-pressed') !== 'true';
    turn?.progress(1).kill();
    if(reduced.matches || document.documentElement.classList.contains('motion-paused')) { setSide(other); return; }
    const [front, back] = sides();
    const [shown, next] = other ? [front, back] : [back, front];
    const dir = other ? 1 : -1;
    // La gota se encoge en un lado y reaparece en el otro con un pequeño rebote.
    turn = gsap.timeline()
      .set(turnButton, { transition: 'none' })
      .to(shown, { rotationY: -90 * dir, duration: .28, ease: 'power2.in' })
      .to(turnButton, { scale: .3, opacity: 0, duration: .24, ease: 'power2.in' }, 0)
      .add(() => { setSide(other); gsap.set(shown, { clearProps: 'transform' }); })
      .fromTo(next, { rotationY: 90 * dir }, { rotationY: 0, duration: .5, ease: 'power3.out', clearProps: 'transform' })
      .fromTo(turnButton, { scale: .3, opacity: 0 }, { scale: 1, opacity: 1, duration: .7, ease: 'elastic.out(1,.5)', clearProps: 'transform,opacity,transition' }, '<.08');
  });
  // 3D swap: the current bag turns away on its Y axis, the next one turns in from the opposite side.
  choices.forEach((choice, index) => choice.addEventListener('click', () => {
    const panel = document.getElementById(`blend-${choice.dataset.select}`);
    if(!panel || choice.getAttribute('aria-pressed') === 'true') return;
    const current = [...panels].find(p => !p.hidden);
    const from = [...choices].findIndex(c => c.getAttribute('aria-pressed') === 'true');
    const dir = index > from ? 1 : -1;
    choices.forEach(button => { const active = button === choice; button.classList.toggle('is-active', active); button.setAttribute('aria-pressed', String(active)); });
    swap?.progress(1).kill();
    const show = () => { panels.forEach(p => { p.hidden = p !== panel; }); if(turnButton?.closest<HTMLElement>('.blend-panel')?.hidden) { turn?.progress(1).kill(); setSide(false); } };
    if(reduced.matches || document.documentElement.classList.contains('motion-paused') || !current) { show(); return; }
    const parts = (p: HTMLElement) => ({ cut: p.querySelectorAll('.blend-cutout'), info: p.querySelector('.blend-info'), disc: p.querySelector('.blend-disc') });
    const out = parts(current), inn = parts(panel);
    // Developer Dúo bags rest tilted via CSS (±10deg); tween into that tilt so clearing props doesn't jump.
    const tilt = (_: number, el: Element) => !el.closest('.is-pair') ? 0 : el.classList.contains('second-cutout') ? 10 : -10;
    swap = gsap.timeline({ defaults: { overwrite: 'auto' } })
      .fromTo(out.cut, { rotation: tilt }, { rotation: 0, rotationY: -75 * dir, x: -60 * dir, z: -220, opacity: 0, duration: .38, ease: 'power2.in', stagger: .04 })
      .to(out.info, { opacity: 0, x: -24 * dir, duration: .3, ease: 'power2.in' }, 0)
      .to(out.disc, { scale: .8, rotationX: 55, opacity: .4, duration: .38, ease: 'power2.in' }, 0)
      .add(() => { show(); gsap.set([out.cut, out.info, out.disc], { clearProps: 'all' }); })
      .fromTo(inn.disc, { scale: .8, rotationX: -55, opacity: .4 }, { scale: 1, rotationX: 0, opacity: 1, duration: .7, ease: 'power3.out' })
      .fromTo(inn.cut, { rotation: 0, rotationY: 75 * dir, x: 60 * dir, z: -220, opacity: 0 }, { rotation: tilt, rotationY: 0, x: 0, z: 0, opacity: 1, duration: .8, ease: 'power3.out', stagger: .08, clearProps: 'transform' }, '<')
      .fromTo(inn.info, { opacity: 0, x: 24 * dir }, { opacity: 1, x: 0, duration: .5, ease: 'power2.out', clearProps: 'transform' }, '<.1');
  }));
  document.querySelectorAll<HTMLElement>('.blend-panel').forEach(card=>{
    const variant=card.querySelector<HTMLSelectElement>('.variant-select')!;
    const grind=card.querySelector<HTMLSelectElement>('.grind-select')!;
    const link=card.querySelector<HTMLAnchorElement>('.whatsapp-order')!;
    const add=card.querySelector<HTMLButtonElement>('.add-to-cart')!;
    const update=()=>{const available=variant.selectedOptions[0].dataset.available!=='false';add.disabled=!available;add.firstChild!.textContent=available?'Este es mi café ':'Agotado por ahora ';add.querySelector('span')!.textContent=available?'+':'';const price=Number(variant.selectedOptions[0].dataset.price);card.querySelector('.product-price')!.textContent=`S/ ${price.toFixed(2)}`;const url=new URL(link.href);url.searchParams.set('text',`¡Hola CodeBrew! Quiero pedir ${card.dataset.product} (${variant.value}), ${grind.value}, por S/ ${price}. ¿Me confirman disponibilidad y envío?`);link.href=url.toString();};
    const view = () => {
      const option = variant.selectedOptions[0];
      track('view_item', {value:Number(option.dataset.price),items:[{item_id:option.dataset.sku!,item_name:card.dataset.product!,price:Number(option.dataset.price),quantity:1}]});
    };
    let seen = '';
    const observer = new IntersectionObserver(entries => {
      if(entries.some(e=>e.isIntersecting) && !card.hidden && seen !== variant.value) { seen=variant.value; view(); }
    }, {threshold:.4});
    observer.observe(card);
    variant.addEventListener('change',()=>{if(!card.hidden){seen=variant.value;view();}});
    variant.addEventListener('change',update);grind.addEventListener('change',update);
    add.addEventListener('click',()=>{addToCart(variant.selectedOptions[0].dataset.sku!,grind.value,1,Number(variant.selectedOptions[0].dataset.price));cartOpen.set(true);});
  });
</script>
