---
import { getWhatsAppUrl } from '../data/config';

const mobileOrderUrl = getWhatsAppUrl('¡Hola CodeBrew! Quiero pedir café de especialidad.');
---

<div class="mobile-sticky-bar" id="mobileStickyBar" aria-hidden="true">
  <div class="sticky-container">
    <div class="sticky-info">
      <span class="sticky-brand font-mono">CodeBrew</span>
      <span class="sticky-text font-mono">SCA 84+ · Amazonas</span>
    </div>

    <a
      href={mobileOrderUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-primary sticky-btn"
      data-event="whatsapp_click"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
      </svg>
      Pedir por WhatsApp
    </a>
  </div>
</div>

<style>
  .mobile-sticky-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background-color: rgba(11, 11, 12, 0.95);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-top: 1px solid var(--line-strong);
    padding: 10px 16px;
    z-index: 80;
    transform: translateY(100%);
    opacity: 0;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .mobile-sticky-bar.is-visible {
    transform: translateY(0);
    opacity: 1;
  }

  .sticky-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    max-width: 520px;
    margin: 0 auto;
  }

  .sticky-info {
    display: flex;
    flex-direction: column;
  }

  .sticky-brand {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text);
  }

  .sticky-text {
    font-size: 0.72rem;
    color: var(--muted);
  }

  .sticky-btn {
    padding: 10px 16px;
    font-size: 0.88rem;
    min-height: 42px;
    flex-shrink: 0;
  }

  @media (min-width: 1024px) {
    .mobile-sticky-bar {
      display: none !important;
    }
  }
</style>

<script>
  const heroElement = document.getElementById('hero');
  const stickyBar = document.getElementById('mobileStickyBar');

  if (heroElement && stickyBar) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          // Si el hero deja de intersectar la pantalla, mostramos la barra sticky en móvil
          if (!entry.isIntersecting) {
            stickyBar.classList.add('is-visible');
            stickyBar.setAttribute('aria-hidden', 'false');
          } else {
            stickyBar.classList.remove('is-visible');
            stickyBar.setAttribute('aria-hidden', 'true');
          }
        });
      },
      {
        threshold: 0.1
      }
    );

    observer.observe(heroElement);
  }
</script>
