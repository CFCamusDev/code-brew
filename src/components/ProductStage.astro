---
import LogoMark from './LogoMark.astro';
---
<div class="coffee-stage" aria-label="Presentación conceptual de café CodeBrew Origen Monteverde de 250 gramos">
  <div class="stage-orbit orbit-one">
</div>
<div class="stage-orbit orbit-two">
</div>
  <span class="stage-caption">UN PEQUEÑO RITUAL.<br />UN GRAN COMIENZO.</span>
  <div class="origin-stamp">
<span>CAFÉ DE ORIGEN</span>
<strong>PE</strong>
<span>AMAZONAS · PERÚ</span>
</div>
  <div class="pouch-shadow">
</div>
  <div class="pouch-position">
    <div class="pouch" aria-hidden="true">
      <div class="pouch-side">
</div>
      <div class="pouch-front">
        <div class="pouch-seal">
</div>
<div class="pouch-valve">
</div>
        <div class="pouch-brand">
<LogoMark size={38} />
<span>codebrew</span>
<small>COFFEE FOR DEVELOPERS</small>
</div>
        <div class="pouch-label">
<span>COLECCIÓN DE ORIGEN / 01</span>
<strong>Monte<br />verde.</strong>
<div class="label-landscape">
<i>
</i>
<i>
</i>
<i>
</i>
</div>
<p>AMAZONAS, PERÚ</p>
<div class="label-details">
<span>TUESTE MEDIO<br />100% ARÁBICA</span>
<b>250 g</b>
</div>
</div>
        <div class="pouch-bottom">BUEN CAFÉ. MEJOR CÓDIGO.</div>
      </div>
    </div>
  </div>
  <div class="stage-note">
<span class="note-line">
</span>
<span>Origen que se siente.<br />
<strong>En cada taza.</strong>
</span>
</div>
  <span class="stage-interaction">↔ Mueve el cursor y explora</span>
</div>
<script>
  const stage = document.querySelector<HTMLElement>('.coffee-stage');
  const pouch = stage?.querySelector<HTMLElement>('.pouch');
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (stage && pouch) {
    stage.addEventListener('pointermove', e => {
      if (motion.matches || e.pointerType !== 'mouse') return;
      const rect = stage.getBoundingClientRect();
      pouch.style.setProperty('--ry', `${-15 + ((e.clientX - rect.left) / rect.width - .5) * 24}deg`);
      pouch.style.setProperty('--rx', `${4 - ((e.clientY - rect.top) / rect.height - .5) * 12}deg`);
    });
    stage.addEventListener('pointerleave', () => { pouch.style.removeProperty('--ry'); pouch.style.removeProperty('--rx'); });
  }
</script>

