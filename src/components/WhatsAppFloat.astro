---
import { getWhatsAppUrl } from '../data/config';

const floatUrl = getWhatsAppUrl('¡Hola CodeBrew! Quisiera hacer una consulta rápida.');
---

<a
  href={floatUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="whatsapp-float-btn"
  aria-label="Contactar a CodeBrew por WhatsApp"
  data-event="whatsapp_click"
>
  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
  </svg>
</a>

<style>
  .whatsapp-float-btn {
    position: fixed;
    bottom: 80px; /* Sobre la barra sticky en móvil si está visible */
    right: 20px;
    z-index: 90;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background-color: var(--accent);
    color: #0B0B0C;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.5), 0 0 12px rgba(200, 137, 74, 0.35);
    border: 1px solid #B4773B;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .whatsapp-float-btn:hover {
    transform: scale(1.08);
    background-color: var(--accent-hover);
  }

  .whatsapp-float-btn:active {
    transform: scale(0.95);
  }

  @media (min-width: 1024px) {
    .whatsapp-float-btn {
      bottom: 28px;
      right: 28px;
    }
  }
</style>
