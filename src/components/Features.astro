---
const features = [
  {
    code: 'feature[0x01]',
    title: 'Origen trazable',
    desc: 'Sin intermediarios oscuros ni mezclas. Conocemos cada finca y altitud exacta en Rodríguez de Mendoza, Amazonas.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"></path><circle cx="12" cy="10" r="3"></circle></svg>`
  },
  {
    code: 'feature[0x02]',
    title: 'Tostado artesanal',
    desc: 'Curvas de tueste calibradas en pequeños lotes semanales para maximizar dulzor natural, notas achocolatadas y acidez balanceada.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"></path><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>`
  },
  {
    code: 'feature[0x03]',
    title: 'Precio justo',
    desc: 'Pago digno y directo al caficultor amazónico por su café 84+ SCA, garantizando sostenibilidad real en origen.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>`
  },
  {
    code: 'feature[0x04]',
    title: 'Ofertas y packs dev',
    desc: 'Opciones en dúo y suscripciones pensadas para equipos de software y home-office que no pueden quedarse sin café.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>`
  }
];

const cuppingProfile = [
  { attribute: 'Dulzor / Panela', score: 94, note: 'Intenso, caramelo artesanal' },
  { attribute: 'Notas a Chocolate Oscuro', score: 92, note: 'Cacao puro amazónico 70%' },
  { attribute: 'Cuerpo Sedoso', score: 89, note: 'Sensación aterciopelada en boca' },
  { attribute: 'Acidez Cítrica Brillante', score: 86, note: 'Naranja dulce de montaña' },
  { attribute: 'Retrogusto Limpio', score: 95, note: 'Persistencia dulce y prolongada' }
];
---

<section class="features-section" id="por-que-codebrew">
  <div class="container">
    <div class="section-header" data-reveal="up">
      <span class="section-label">// 03 — features</span>
      <h2 class="section-title">Por qué elegir CodeBrew</h2>
      <p class="section-subtitle">
        Diseñado con la misma obsesión por la calidad y la pureza con la que escribes código en producción.
      </p>
    </div>

    <div class="features-grid">
      {features.map((item, idx) => (
        <div class="feature-glass-card" data-reveal="up" data-reveal-delay={(idx * 90).toString()}>
          <div class="feature-card-shine"></div>
          <div class="feature-top">
            <div class="feature-icon-badge" set:html={item.icon} />
            <span class="feature-code font-mono">{item.code}</span>
          </div>
          <h3 class="feature-title">{item.title}</h3>
          <p class="feature-desc">{item.desc}</p>
        </div>
      ))}
    </div>

    <!-- Panel Novedoso: Telemetría de Cata Sensorial SCA 84+ -->
    <div class="cupping-telemetry-panel" data-reveal="scale" data-reveal-delay="100">
      <div class="telemetry-header">
        <div class="telemetry-title-group">
          <span class="telemetry-tag font-mono">// sca_cupping_protocol</span>
          <h3 class="telemetry-heading">Perfil Sensorial & Calibración de Taza</h3>
        </div>
        <div class="telemetry-badge font-mono">
          <span class="badge-dot-active"></span> CALIBRACIÓN 84.5 PTS
        </div>
      </div>

      <div class="telemetry-bars-grid">
        {cuppingProfile.map((item) => (
          <div class="telemetry-row">
            <div class="telemetry-meta">
              <span class="telemetry-attr font-mono">{item.attribute}</span>
              <span class="telemetry-note font-mono">// {item.note}</span>
              <span class="telemetry-score font-mono">{item.score}%</span>
            </div>
            <div class="telemetry-track">
              <div class="telemetry-fill" data-progress-bar={item.score.toString()} style="width: 0%;">
                <span class="telemetry-glow-lead"></span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .features-section {
    padding: clamp(64px, 8vw, 96px) 0;
    border-bottom: 1px solid var(--line);
    background-color: var(--bg);
    position: relative;
    overflow: hidden;
  }

  .section-header {
    max-width: 720px;
    margin-bottom: clamp(32px, 5vw, 48px);
  }

  .section-title {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin-bottom: 14px;
  }

  .section-subtitle {
    font-size: 1rem;
    line-height: 1.65;
  }

  .features-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    width: 100%;
    margin-bottom: 36px;
  }

  /* Tarjeta Feature Glassmorphic 3D */
  .feature-glass-card {
    background: rgba(20, 21, 26, 0.75);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 26px 22px;
    position: relative;
    overflow: hidden;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.45);
    transition: transform var(--transition-normal), border-color var(--transition-normal), box-shadow var(--transition-normal);
    min-width: 0;
  }

  .feature-glass-card:hover {
    border-color: rgba(200, 137, 74, 0.38);
    transform: translateY(-3px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.6), 0 0 20px rgba(200, 137, 74, 0.1);
  }

  .feature-card-shine {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--metal-shine);
    pointer-events: none;
  }

  .feature-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
  }

  .feature-icon-badge {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(200, 137, 74, 0.12);
    border: 1px solid rgba(200, 137, 74, 0.25);
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 14px rgba(200, 137, 74, 0.15);
    transition: transform var(--transition-fast), background var(--transition-fast);
  }

  .feature-glass-card:hover .feature-icon-badge {
    transform: scale(1.06);
    background: rgba(200, 137, 74, 0.2);
  }

  .feature-code {
    font-size: 0.72rem;
    color: var(--accent-2);
    background: rgba(127, 214, 155, 0.08);
    border: 1px solid rgba(127, 214, 155, 0.18);
    padding: 2px 7px;
    border-radius: 4px;
  }

  .feature-title {
    font-size: 1.22rem;
    margin-bottom: 10px;
    color: var(--text);
  }

  .feature-desc {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--muted);
  }

  /* ==========================================================================
     Panel de Telemetría Sensorial SCA (Diseño Glass & Barras Luminosas)
     ========================================================================== */
  .cupping-telemetry-panel {
    background: rgba(18, 19, 24, 0.82);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 18px;
    padding: clamp(24px, 4vw, 36px);
    box-shadow: 0 16px 44px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.08);
    position: relative;
    overflow: hidden;
  }

  .telemetry-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 26px;
    flex-wrap: wrap;
    gap: 14px;
  }

  .telemetry-tag {
    font-size: 0.76rem;
    color: var(--accent-2);
    margin-bottom: 4px;
    display: block;
  }

  .telemetry-heading {
    font-size: clamp(1.2rem, 3vw, 1.6rem);
    color: var(--text);
  }

  .telemetry-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.74rem;
    color: var(--accent);
    background: rgba(200, 137, 74, 0.14);
    border: 1px solid rgba(200, 137, 74, 0.32);
    padding: 4px 10px;
    border-radius: 20px;
    font-weight: 700;
  }

  .badge-dot-active {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent);
    box-shadow: 0 0 6px var(--accent);
  }

  .telemetry-bars-grid {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .telemetry-row {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .telemetry-meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
  }

  .telemetry-attr {
    font-size: 0.84rem;
    color: var(--text);
    font-weight: 600;
  }

  .telemetry-note {
    font-size: 0.74rem;
    color: var(--muted);
    display: none;
  }

  .telemetry-score {
    font-size: 0.88rem;
    color: var(--accent);
    font-weight: 700;
  }

  .telemetry-track {
    width: 100%;
    height: 7px;
    background: rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    overflow: hidden;
    position: relative;
  }

  .telemetry-fill {
    height: 100%;
    background: linear-gradient(90deg, #7FD69B 0%, #C8894A 100%);
    border-radius: 8px;
    position: relative;
    box-shadow: 0 0 10px rgba(200, 137, 74, 0.4);
    transition: width 1s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .telemetry-glow-lead {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 10px;
    background: #FFF;
    filter: blur(2px);
    opacity: 0.7;
  }

  @media (min-width: 640px) {
    .features-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .telemetry-note {
      display: inline-block;
    }
  }

  @media (min-width: 1024px) {
    .features-section {
      padding: 96px 0;
    }

    .features-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 24px;
    }
  }
</style>
