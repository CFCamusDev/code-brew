---
const features = [
  {
    code: 'feature[0]',
    title: 'Origen trazable',
    desc: 'Sin intermediarios oscuros ni mezclas. Conocemos cada finca y altitud exacta en Rodríguez de Mendoza, Amazonas.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"></path><circle cx="12" cy="10" r="3"></circle></svg>`
  },
  {
    code: 'feature[1]',
    title: 'Tostado artesanal',
    desc: 'Curvas de tueste calibradas en pequeños lotes semanales para maximizar dulzor natural, notas achocolatadas y acidez balanceada.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"></path><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>`
  },
  {
    code: 'feature[2]',
    title: 'Precio justo',
    desc: 'Pago digno y directo al caficultor amazónico por su café 84+ SCA, garantizando sostenibilidad real en origen.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>`
  },
  {
    code: 'feature[3]',
    title: 'Ofertas y packs dev',
    desc: 'Opciones en dúo y suscripciones pensadas para equipos de software y home-office que no pueden quedarse sin café.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>`
  }
];
---

<section class="features-section" id="por-que-codebrew">
  <div class="container">
    <div class="section-header">
      <span class="section-label">// 03 — features</span>
      <h2 class="section-title">Por qué elegir CodeBrew</h2>
      <p class="section-subtitle">
        Diseñado con la misma obsesión por la calidad y la pureza con la que escribes código en producción.
      </p>
    </div>

    <div class="features-grid">
      {features.map((item) => (
        <div class="feature-card">
          <div class="feature-top">
            <div class="feature-icon" set:html={item.icon} />
            <span class="feature-code font-mono">{item.code}</span>
          </div>
          <h3 class="feature-title">{item.title}</h3>
          <p class="feature-desc">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features-section {
    padding: 72px 0;
    border-bottom: 1px solid var(--line);
    background-color: var(--bg);
  }

  .section-header {
    max-width: 720px;
    margin-bottom: 40px;
  }

  .section-title {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin-bottom: 14px;
  }

  .section-subtitle {
    font-size: 1rem;
    line-height: 1.65;
  }

  .features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .feature-card {
    background-color: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 28px 24px;
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }

  .feature-card:hover {
    border-color: #3C3C44;
    transform: translateY(-2px);
  }

  .feature-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
  }

  .feature-icon {
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .feature-code {
    font-size: 0.75rem;
    color: var(--accent-2);
  }

  .feature-title {
    font-size: 1.2rem;
    margin-bottom: 10px;
    color: var(--text);
  }

  .feature-desc {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--muted);
  }

  @media (min-width: 640px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .features-section {
      padding: 96px 0;
    }

    .features-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }
  }
</style>
