---
import { whatsAppContextForPath } from '../lib/whatsapp';
const context = whatsAppContextForPath(Astro.url.pathname);
---
<a
  class="floating-whatsapp"
  data-floating-whatsapp
  href={`/api/contact/whatsapp?context=${context}`}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escribir a CodeBrew por WhatsApp (se abre en otra pestaña)"
  title="Escríbenos por WhatsApp"
>
  <svg class="floating-whatsapp-icon" viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true" focusable="false">
    <path d="M20.52 3.48A11.88 11.88 0 0 0 12.05 0C5.46 0 .1 5.36.1 11.95c0 2.1.55 4.16 1.6 5.97L0 24l6.24-1.64a11.9 11.9 0 0 0 5.8 1.48h.01c6.59 0 11.95-5.36 11.95-11.95 0-3.2-1.24-6.2-3.48-8.41ZM12.05 21.82a9.9 9.9 0 0 1-5.04-1.38l-.36-.21-3.7.97.99-3.61-.24-.37a9.9 9.9 0 0 1-1.51-5.27c0-5.46 4.44-9.9 9.91-9.9a9.83 9.83 0 0 1 7 2.9 9.84 9.84 0 0 1 2.9 7c0 5.45-4.44 9.87-9.95 9.87Zm5.43-7.4c-.3-.15-1.77-.87-2.04-.97-.28-.1-.48-.15-.68.15s-.77.97-.94 1.17c-.17.2-.35.23-.65.08-.3-.15-1.26-.46-2.4-1.48-.89-.8-1.49-1.78-1.66-2.08-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.68-1.64-.93-2.25-.24-.59-.49-.51-.68-.52h-.58c-.2 0-.52.08-.8.38-.27.3-1.04 1.02-1.04 2.49s1.07 2.89 1.22 3.09c.15.2 2.11 3.22 5.12 4.51.71.31 1.27.49 1.7.62.71.23 1.36.2 1.87.12.57-.08 1.77-.72 2.02-1.42.25-.69.25-1.29.17-1.42-.07-.12-.27-.2-.57-.35Z" />
  </svg>
  <span class="floating-whatsapp-copy" aria-hidden="true"><strong>¿Te ayudamos?</strong><span>WhatsApp</span></span>
</a>
<style>
  .floating-whatsapp {
    position:fixed;
    right:max(24px,env(safe-area-inset-right));
    bottom:max(24px,env(safe-area-inset-bottom));
    z-index:40;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:12px;
    min-width:56px;
    min-height:56px;
    padding:12px 20px 12px 16px;
    border:1px solid #ffffff60;
    border-radius:999px;
    background:#176b4b;
    color:#fff;
    text-decoration:none;
    box-shadow:0 6px 24px #163d2c26,inset 0 1px 0 #ffffff24;
    transition:background .2s,box-shadow .2s,transform .2s;
  }
  .floating-whatsapp:hover{background:#12563c;box-shadow:0 10px 28px #163d2c38;transform:translateY(-2px)}
  .floating-whatsapp:focus-visible{outline:3px solid #203c32;outline-offset:4px;box-shadow:0 0 0 3px #fff}
  .floating-whatsapp-icon{flex:none}
  .floating-whatsapp-copy{display:grid;gap:2px;line-height:1.2}
  .floating-whatsapp-copy strong{font-size:12px;font-weight:600}
  .floating-whatsapp-copy>span{font-size:10px;opacity:.85;letter-spacing:.03em}
  :global(html:has(.floating-whatsapp)){scroll-padding-bottom:calc(96px + env(safe-area-inset-bottom))}
  :global(body:has(dialog[open])) .floating-whatsapp{visibility:hidden;pointer-events:none}
  @media(max-width:700px){
    .floating-whatsapp{right:max(16px,env(safe-area-inset-right));bottom:max(16px,env(safe-area-inset-bottom));width:56px;height:56px;padding:0}
    .floating-whatsapp-copy{display:none}
    :global(body:has(input:not([type="checkbox"]):not([type="radio"]):focus,textarea:focus,select:focus)) .floating-whatsapp{visibility:hidden;pointer-events:none}
  }
  @media(prefers-reduced-motion:reduce){.floating-whatsapp{transition:none}.floating-whatsapp:hover{transform:none}}
  @media print{.floating-whatsapp{display:none}}
</style>
