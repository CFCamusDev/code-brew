---
import { getWhatsAppUrl } from '../data/config';
import { getSetting, SOCIAL_LINKS_KEY, type SocialLinks } from '../lib/server/settings';
const whatsappUrl = await getWhatsAppUrl();
const social = await getSetting<SocialLinks>(SOCIAL_LINKS_KEY, { instagram:'https://www.instagram.com/codebrewc/',tiktok:'https://www.tiktok.com/@coffecodebrew',facebook:'',whatsapp:'' });
---
<footer class="cb-footer"><div class="cb-wrap"><div class="cb-footer-top"><p>Café de origen.<br />Espíritu developer.</p><nav aria-label="Redes sociales de CodeBrew"><a href={whatsappUrl} target="_blank" rel="noopener noreferrer" data-event="whatsapp_click">WhatsApp ↗</a>{social.instagram && <a href={social.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a>}{social.tiktok && <a href={social.tiktok} target="_blank" rel="noopener noreferrer">TikTok ↗</a>}{social.facebook && <a href={social.facebook} target="_blank" rel="noopener noreferrer">Facebook ↗</a>}</nav><nav aria-label="Políticas de CodeBrew"><a href="/politicas/terminos">Términos</a><a href="/politicas/privacidad">Privacidad</a><a href="/politicas/envios-devoluciones">Envíos y devoluciones</a><a href="/reclamos">Libro de Reclamaciones</a><a href="/pedido">Consultar mi pedido</a></nav></div><div class="cb-footer-bottom"><span>© {new Date().getFullYear()} CODEBREW · HECHO EN PERÚ</span><span>BUEN CAFÉ. MEJOR CÓDIGO.</span><a href="#top">Volver arriba ↑</a></div><div class="cb-footer-wordmark" aria-hidden="true">codebrew</div></div></footer>