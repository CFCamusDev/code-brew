---
import { getWhatsAppUrl } from '../data/config';
import LogoMark from './LogoMark.astro';

const whatsappUrl = getWhatsAppUrl();
---

<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="#" class="brand-logo" aria-label="CodeBrew inicio">
          <LogoMark size={24} />
          <span class="logo-code">Code</span><span class="logo-brew">Brew</span>
        </a>
        <p class="footer-tagline font-mono">// Café que despierta ideas.</p>
        <p class="footer-location">Rodríguez de Mendoza, Amazonas · Perú</p>
      </div>

      <div class="footer-socials" aria-label="Redes sociales de CodeBrew">
        <!-- Instagram -->
        <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="Instagram de CodeBrew">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </a>

        <!-- TikTok -->
        <a href="https://tiktok.com" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="TikTok de CodeBrew">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path>
          </svg>
        </a>

        <!-- Facebook -->
        <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="Facebook de CodeBrew">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
          </svg>
        </a>

        <!-- LinkedIn -->
        <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="LinkedIn de CodeBrew">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
            <rect x="2" y="9" width="4" height="12"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
        </a>

        <!-- WhatsApp -->
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="social-link" aria-label="WhatsApp directo de CodeBrew" data-event="whatsapp_click">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
        </a>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="copyright font-mono">
        &copy; 2026 CodeBrew &middot; Café de Rodríguez de Mendoza, Amazonas
      </p>
      <span class="system-status font-mono">system.status = 'all systems operational'</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: #080809;
    border-top: 1px solid var(--line);
    padding: 48px 0 32px 0;
  }

  .footer-container {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .footer-top {
    display: flex;
    flex-direction: column;
    gap: 24px;
    justify-content: space-between;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .brand-logo {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .logo-code { color: var(--text); }
  .logo-brew { color: var(--accent); }

  .footer-tagline {
    font-size: 0.85rem;
    color: var(--accent-2);
  }

  .footer-location {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .footer-socials {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background-color: var(--surface);
    border: 1px solid var(--line);
    color: var(--muted);
    transition: color var(--transition-fast), border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .social-link:hover {
    color: var(--accent);
    border-color: var(--accent);
    background-color: var(--surface-hover);
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 24px;
    border-top: 1px solid #1A1A1E;
    justify-content: space-between;
  }

  .copyright {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .system-status {
    font-size: 0.75rem;
    color: #55555C;
  }

  @media (min-width: 768px) {
    .footer-top {
      flex-direction: row;
      align-items: flex-end;
    }

    .footer-bottom {
      flex-direction: row;
      align-items: center;
    }
  }
</style>
