---
import { getWhatsAppUrl } from '../data/config';
import { getSetting, SOCIAL_LINKS_KEY, type SocialLinks } from '../server/modules/settings';
interface Props { staticContent?: boolean; }
const { staticContent = false } = Astro.props;
const whatsappUrl = staticContent ? '/api/contact/whatsapp' : await getWhatsAppUrl();
const defaults: SocialLinks = { instagram:'https://www.instagram.com/codebrewc/',tiktok:'https://www.tiktok.com/@coffecodebrew',facebook:'',whatsapp:'' };
const social = staticContent ? defaults : await getSetting<SocialLinks>(SOCIAL_LINKS_KEY, defaults);
---
<footer class="cb-footer"><div class="cb-wrap"><div class="cb-footer-top"><p>Café de origen.<br />Espíritu developer.</p><nav aria-label="Redes sociales de CodeBrew"><a href={whatsappUrl} target="_blank" rel="noopener noreferrer" data-event="whatsapp_click">WhatsApp ↗</a>{social.instagram && <a href={social.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a>}{social.tiktok && <a href={social.tiktok} target="_blank" rel="noopener noreferrer">TikTok ↗</a>}{social.facebook && <a href={social.facebook} target="_blank" rel="noopener noreferrer">Facebook ↗</a>}</nav><nav aria-label="Políticas de CodeBrew"><a href="/politicas/terminos">Términos</a><a href="/politicas/privacidad">Privacidad</a><a href="/politicas/envios-devoluciones">Envíos y devoluciones</a><a href="/reclamos">Libro de Reclamaciones</a><a href="/pedido">Consultar mi pedido</a></nav></div><div class="cb-footer-bottom"><span>© {new Date().getFullYear()} CODEBREW · HECHO EN PERÚ</span><span>BUEN CAFÉ. MEJOR CÓDIGO.</span><a href="#main-content">Volver arriba ↑</a></div><svg class="cb-footer-wordmark" viewBox="0 0 1160 215" aria-hidden="true" focusable="false"><text x="580" y="210" text-anchor="middle" font-family="EB Garamond, Georgia, serif" font-weight="600" font-size="300" letter-spacing="-15" fill="#f4f1e9" fill-opacity=".06">codebrew</text></svg></div></footer>