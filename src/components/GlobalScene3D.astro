---
---

<div class="global-3d-wrapper" id="global3DWrapper" aria-hidden="true">
  <canvas id="globalCanvas3D" class="global-canvas-3d"></canvas>
  <div class="global-spotlight" id="globalSpotlight"></div>
</div>

<style>
  .global-3d-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .global-canvas-3d {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0.85;
  }

  /* Spotlight interactivo que sigue al cursor */
  .global-spotlight {
    position: absolute;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(200, 137, 74, 0.08) 0%, rgba(127, 214, 155, 0.03) 40%, transparent 70%);
    pointer-events: none;
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity 0.5s ease;
    mix-blend-mode: screen;
  }

  @media (min-width: 1024px) {
    .global-spotlight {
      opacity: 1;
    }
  }
</style>

<script>
  import * as THREE from 'three';

  function initGlobal3D() {
    const wrapper = document.getElementById('global3DWrapper');
    const canvas = document.getElementById('globalCanvas3D') as HTMLCanvasElement;
    const spotlight = document.getElementById('globalSpotlight');
    if (!wrapper || !canvas) return;

    let width = window.innerWidth;
    let height = window.innerHeight;

    // 1. Escena & Cámara
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(50, width / height, 0.1, 1000);
    camera.position.z = 24;

    // 2. Renderer optimizado de fondo
    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: false, // Fondo no necesita MSAA pesado
      powerPreference: 'high-performance'
    });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
    renderer.outputColorSpace = THREE.SRGBColorSpace;

    // 3. Luces tenues
    const ambientLight = new THREE.AmbientLight(0x111116, 1.2);
    scene.add(ambientLight);

    const pointLight = new THREE.PointLight(0xC8894A, 3.5, 40);
    pointLight.position.set(0, 0, 10);
    scene.add(pointLight);

    const terminalLight = new THREE.PointLight(0x7FD69B, 2.0, 30);
    terminalLight.position.set(-15, 10, 5);
    scene.add(terminalLight);

    // 4. Sistema de Polvo de Café Cósmico & Partículas de Sintaxis
    const isMobile = window.innerWidth < 768;
    const particleCount = isMobile ? 140 : 360;

    const particleGeom = new THREE.BufferGeometry();
    const positions = new Float32Array(particleCount * 3);
    const colors = new Float32Array(particleCount * 3);
    const scales = new Float32Array(particleCount);
    const basePositions = new Float32Array(particleCount * 3);

    const copperColor = new THREE.Color(0xC8894A);
    const terminalColor = new THREE.Color(0x7FD69B);
    const ashColor = new THREE.Color(0x4A4A52);

    for (let i = 0; i < particleCount; i++) {
      const idx = i * 3;
      // Dispersión a lo largo del túnel espacial
      const x = (Math.random() - 0.5) * 44;
      const y = (Math.random() - 0.5) * 60;
      const z = (Math.random() - 0.5) * 30;

      positions[idx] = x;
      positions[idx + 1] = y;
      positions[idx + 2] = z;

      basePositions[idx] = x;
      basePositions[idx + 1] = y;
      basePositions[idx + 2] = z;

      // Color aleatorio temático
      const rand = Math.random();
      let c = ashColor;
      if (rand > 0.65) c = copperColor;
      else if (rand > 0.45) c = terminalColor;

      colors[idx] = c.r;
      colors[idx + 1] = c.g;
      colors[idx + 2] = c.b;

      scales[i] = Math.random() * 2.2 + 0.8;
    }

    particleGeom.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    particleGeom.setAttribute('color', new THREE.BufferAttribute(colors, 3));

    // Shader o material de puntos circulares suaves
    // Generar textura de círculo suave proceduralmente
    const particleCanvas = document.createElement('canvas');
    particleCanvas.width = 32;
    particleCanvas.height = 32;
    const pctx = particleCanvas.getContext('2d')!;
    const grad = pctx.createRadialGradient(16, 16, 0, 16, 16, 16);
    grad.addColorStop(0, 'rgba(255,255,255,1)');
    grad.addColorStop(0.4, 'rgba(255,255,255,0.7)');
    grad.addColorStop(1, 'rgba(255,255,255,0)');
    pctx.fillStyle = grad;
    pctx.beginPath();
    pctx.arc(16, 16, 16, 0, Math.PI * 2);
    pctx.fill();

    const circleTexture = new THREE.CanvasTexture(particleCanvas);

    const particleMaterial = new THREE.PointsMaterial({
      size: isMobile ? 0.35 : 0.45,
      vertexColors: true,
      map: circleTexture,
      transparent: true,
      opacity: 0.65,
      blending: THREE.AdditiveBlending,
      depthWrite: false
    });

    const particleSystem = new THREE.Points(particleGeom, particleMaterial);
    scene.add(particleSystem);

    // 5. Granos de Café Flotantes a lo largo del Scroll Vertical
    const beanTextureLoader = new THREE.TextureLoader();
    const beanTex = beanTextureLoader.load('/assets/3d/coffee-bean.png');
    beanTex.colorSpace = THREE.SRGBColorSpace;

    function makeBeanGeometry(): THREE.BufferGeometry {
      const geom = new THREE.SphereGeometry(0.7, 24, 24);
      const pos = geom.attributes.position;
      for (let i = 0; i < pos.count; i++) {
        let bx = pos.getX(i) * 0.8;
        let by = pos.getY(i) * 1.35;
        let bz = pos.getZ(i) * 0.65;
        if (bz > 0) {
          const depth = Math.exp(-Math.pow(Math.abs(bx) / 0.18, 2));
          bz -= depth * 0.35;
        }
        pos.setXYZ(i, bx, by, bz);
      }
      geom.computeVertexNormals();
      return geom;
    }

    const beanGeom = makeBeanGeometry();
    const beanMat = new THREE.MeshPhysicalMaterial({
      map: beanTex,
      color: 0x55341A,
      roughness: 0.5,
      metalness: 0.1,
      clearcoat: 0.2
    });

    // Crear 6 granos espaciados en profundidad a lo largo de las secciones
    interface ScrollBean {
      mesh: THREE.Mesh;
      baseX: number;
      baseY: number;
      baseZ: number;
      rotSpeedX: number;
      rotSpeedY: number;
      scrollFactor: number;
    }

    const scrollBeans: ScrollBean[] = [];
    const beanPositions = [
      { x: -14, y: 12, z: -2, s: 0.003, scale: 0.9 },   // Hero lateral izq
      { x: 15, y: 4, z: -6, s: -0.0025, scale: 0.75 },  // Origen lateral der
      { x: -13, y: -4, z: -4, s: 0.003, scale: 0.8 },   // Productos lateral izq
      { x: 14, y: -12, z: -3, s: -0.002, scale: 0.85 }, // Features lateral der
      { x: -12, y: -20, z: -5, s: 0.0025, scale: 0.7 }, // How to order izq
      { x: 13, y: -28, z: -2, s: -0.003, scale: 0.95 }  // CTA final der
    ];

    beanPositions.forEach((bp) => {
      const m = new THREE.Mesh(beanGeom, beanMat);
      m.position.set(bp.x, bp.y, bp.z);
      m.scale.setScalar(bp.scale);
      scene.add(m);

      scrollBeans.push({
        mesh: m,
        baseX: bp.x,
        baseY: bp.y,
        baseZ: bp.z,
        rotSpeedX: (Math.random() - 0.5) * 0.015,
        rotSpeedY: (Math.random() - 0.5) * 0.015,
        scrollFactor: bp.s
      });
    });

    // 6. Seguimiento de Scroll y Ratón
    let scrollY = window.scrollY;
    let targetScrollY = window.scrollY;
    let mouseX = 0;
    let mouseY = 0;
    let targetMouseX = 0;
    let targetMouseY = 0;

    window.addEventListener('scroll', () => {
      targetScrollY = window.scrollY;
    }, { passive: true });

    window.addEventListener('pointermove', (e) => {
      targetMouseX = (e.clientX / window.innerWidth - 0.5) * 2;
      targetMouseY = (e.clientY / window.innerHeight - 0.5) * 2;

      if (spotlight) {
        spotlight.style.left = `${e.clientX}px`;
        spotlight.style.top = `${e.clientY}px`;
      }
    }, { passive: true });

    // 7. Bucle de Renderizado
    let clock = new THREE.Clock();
    let animId: number;

    function renderGlobal() {
      animId = requestAnimationFrame(renderGlobal);

      const elapsed = clock.getElapsedTime();

      // Suavizado lerp de scroll y mouse
      scrollY += (targetScrollY - scrollY) * 0.08;
      mouseX += (targetMouseX - mouseX) * 0.05;
      mouseY += (targetMouseY - mouseY) * 0.05;

      // Movimiento vertical de la cámara ligado al scroll de la página
      const maxScroll = Math.max(1, document.body.scrollHeight - window.innerHeight);
      const scrollProgress = scrollY / maxScroll; // de 0 a 1

      camera.position.y = 8 - scrollProgress * 36;
      camera.position.x = mouseX * 1.5;
      pointLight.position.x = mouseX * 8;
      pointLight.position.y = camera.position.y - mouseY * 4;

      // Ondulación de las partículas de café cósmicas
      const pPos = particleGeom.attributes.position;
      for (let i = 0; i < particleCount; i++) {
        const idx = i * 3;
        const bx = basePositions[idx];
        const by = basePositions[idx + 1];

        // Deriva flotante suave
        positions[idx] = bx + Math.sin(elapsed * 0.4 + i) * 0.8 + mouseX * 0.5;
        positions[idx + 1] = by + Math.cos(elapsed * 0.35 + i * 0.5) * 0.8;
      }
      pPos.needsUpdate = true;

      // Rotación suave del campo de partículas
      particleSystem.rotation.y = elapsed * 0.02 + mouseX * 0.05;

      // Rotación y flotación de los granos a lo largo del scroll
      scrollBeans.forEach((b) => {
        b.mesh.rotation.x += b.rotSpeedX;
        b.mesh.rotation.y += b.rotSpeedY;
        b.mesh.position.y = b.baseY + Math.sin(elapsed * 1.2 + b.baseX) * 0.4;
      });

      renderer.render(scene, camera);
    }

    renderGlobal();

    // 8. Responsive Resize
    window.addEventListener('resize', () => {
      width = window.innerWidth;
      height = window.innerHeight;
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height);
    });

    // 9. Ahorro de batería cuando la pestaña se minimiza
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        cancelAnimationFrame(animId);
      } else {
        clock.start();
        renderGlobal();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGlobal3D);
  } else {
    initGlobal3D();
  }
</script>
