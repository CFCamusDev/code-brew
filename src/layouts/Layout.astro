---
import '../styles/fonts.css';
import '../styles/brand.css';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import displayFont from '../assets/fonts/eb-garamond-latin-wght-normal.woff2?url';
import bodyFont from '../assets/fonts/geist-latin-wght-normal.woff2?url';
interface Props { title?: string; description?: string; noindex?: boolean; }
const { noindex = false, title = 'CodeBrew — Buen café. Grandes ideas.', description = 'Café de especialidad de Amazonas, Perú, para quienes crean. Descubre tu próximo ritual y elige tu café en grano o molido.' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#203c32" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_PE" />
    <script>
      import { initAnalytics } from '../lib/analytics';
      initAnalytics();
    </script>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" as="font" type="font/woff2" href={displayFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={bodyFont} crossorigin />
  </head>
  <body class="cb-site">
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <slot />
    <FloatingWhatsApp />
  </body>
</html>
