---
import '../styles/global.css';
import '../styles/admin.css';
import LogoMark from '../components/LogoMark.astro';

interface Props {
  title: string;
}
const { title } = Astro.props;
const admin = Astro.locals.admin;
const path = Astro.url.pathname;

// Íconos de trazo (24×24) para el menú; heredan el color del texto.
const ICONS = {
  inicio: '<path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
  pedidos: '<path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 17.5v-11"/>',
  clientes: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  productos: '<path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/>',
  envios: '<path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/>',
  compras: '<path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/>',
  usuarios: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>',
  reclamos: '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/><path d="M12 8v4"/><path d="M12 16h.01"/>',
  configuracion: '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>',
  cuenta: '<circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 0 0-16 0"/>',
  salir: '<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/>',
  luna: '<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>',
  sol: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>'
} as const;

const nav = [
  { href: '/admin', label: 'Inicio', icon: ICONS.inicio, exact: true },
  { href: '/admin/pedidos', label: 'Pedidos', icon: ICONS.pedidos },
  { href: '/admin/clientes', label: 'Clientes', icon: ICONS.clientes },
  { href: '/admin/productos', label: 'Productos y stock', icon: ICONS.productos },
  { href: '/admin/envios', label: 'Envíos', icon: ICONS.envios },
  { href: '/admin/compras', label: 'Compras y gastos', icon: ICONS.compras },
  { href: '/admin/reclamos', label: 'Reclamos', icon: ICONS.reclamos },
  ...(admin?.role === 'admin'
    ? [
        { href: '/admin/usuarios', label: 'Usuarios', icon: ICONS.usuarios },
        { href: '/admin/configuracion', label: 'Configuración', icon: ICONS.configuracion }
      ]
    : []),
  { href: '/admin/cuenta', label: 'Mi cuenta', icon: ICONS.cuenta }
];
const initials = admin?.name
  .split(/\s+/)
  .slice(0, 2)
  .map(part => part[0]?.toUpperCase())
  .join('');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#efebe1" />
    <!-- Aplica el tema guardado (o el del sistema) antes de pintar: evita el destello de tema equivocado -->
    <script is:inline>
      (function () {
        var theme = 'light';
        try {
          var saved = localStorage.getItem('cb-admin-theme');
          theme = saved === 'dark' || saved === 'light' ? saved : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        } catch (e) {}
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <title>{title} · Panel CodeBrew</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&family=Geist+Mono:wght@500;600&display=swap" rel="stylesheet" />
  </head>
  <body class="admin-body">
    <!-- Fondo con color para que el vidrio tenga algo que difuminar -->
    <div class="ambient" aria-hidden="true"><span></span><span></span><span></span></div>
    {admin ? (
      <div class="admin-shell">
        <aside class="admin-sidebar glass">
          <a class="admin-brand" href="/admin">
            <span class="brand-mark"><LogoMark size={20} /></span>
            <span>codebrew<small>panel</small></span>
          </a>
          <nav aria-label="Panel">
            {nav.map(item => (
              <a href={item.href} aria-current={(item.exact ? path === item.href : path.startsWith(item.href)) ? 'page' : undefined}>
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={item.icon} />
                <span>{item.label}</span>
              </a>
            ))}
          </nav>
          <div class="admin-user">
            <span class="avatar" aria-hidden="true">{initials}</span>
            <span class="who">
              <span>{admin.name}</span>
              <small>{admin.role === 'admin' ? 'Administrador' : 'Operador'}</small>
            </span>
            <button type="button" class="theme-toggle" data-theme-toggle aria-label="Cambiar a modo noche" title="Modo día / noche">
              <svg class="nav-icon icon-moon" viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS.luna} />
              <svg class="nav-icon icon-sun" viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS.sol} />
            </button>
            <button type="button" class="theme-toggle" id="admin-logout" aria-label="Cerrar sesión" title="Cerrar sesión">
              <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS.salir} />
            </button>
          </div>
        </aside>
        <main class="admin-main" id="main-content">
          <slot />
        </main>
      </div>
    ) : (
      <main class="admin-login-wrap">
        <button type="button" class="theme-toggle login-theme" data-theme-toggle aria-label="Cambiar a modo noche" title="Modo día / noche">
          <svg class="nav-icon icon-moon" viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS.luna} />
          <svg class="nav-icon icon-sun" viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS.sol} />
        </button>
        <slot />
      </main>
    )}
    <script>
      // Modo día / noche: se recuerda en este navegador; sin elección guardada sigue al sistema.
      const root = document.documentElement;
      const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
      const toggles = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
      const paint = (theme: string) => {
        root.dataset.theme = theme;
        themeColor?.setAttribute('content', theme === 'dark' ? '#0e1713' : '#efebe1');
        toggles.forEach(button => button.setAttribute('aria-label', theme === 'dark' ? 'Cambiar a modo día' : 'Cambiar a modo noche'));
      };
      paint(root.dataset.theme ?? 'light');
      toggles.forEach(button =>
        button.addEventListener('click', () => {
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          paint(next);
          try {
            localStorage.setItem('cb-admin-theme', next);
          } catch {}
        })
      );
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', event => {
        let saved: string | null = null;
        try {
          saved = localStorage.getItem('cb-admin-theme');
        } catch {}
        if (!saved) paint(event.matches ? 'dark' : 'light');
      });

      document.getElementById('admin-logout')?.addEventListener('click', async () => {
        await fetch('/api/admin/logout', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' });
        window.location.assign('/admin/login');
      });
    </script>
  </body>
</html>
