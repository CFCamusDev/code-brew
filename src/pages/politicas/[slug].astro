---
import Footer from '../../components/Footer.astro';
import Layout from '../../layouts/Layout.astro';
import ShopHeader from '../../components/shop/ShopHeader.astro';
import { getSetting, POLICY_KEYS, type PolicySlug, type PolicyContent } from '../../lib/server/settings';
import '../../styles/shop.css';

export const prerender = false;

const { slug } = Astro.params;
if (!slug || !(slug in POLICY_KEYS)) return new Response('Página no encontrada', { status: 404 });

const key = POLICY_KEYS[slug as PolicySlug];
const policy = await getSetting<PolicyContent>(key, { title: '', body: '' });
const hasContent = policy.body.trim().length > 0;
---
<Layout title={`${policy.title || 'Política'} — CodeBrew`} description={`${policy.title} de CodeBrew.`}>
  <ShopHeader />
  <main id="main-content" class="shop-main order-page policy-page cb-policy-layout">
    <aside class="cb-policy-nav"><p class="cb-label">Información de CodeBrew</p><h2>Todo con <em>claridad.</em></h2><nav aria-label="Documentos legales">{Object.entries(POLICY_KEYS).map(([key])=><a href={'/politicas/'+key} aria-current={slug===key?'page':undefined}>{({'terminos':'Términos y condiciones','privacidad':'Privacidad','envios-devoluciones':'Envíos y devoluciones'} as Record<string,string>)[key]}<span aria-hidden="true">↗</span></a>)}<a href="/reclamos">Libro de Reclamaciones <span aria-hidden="true">↗</span></a></nav></aside><article class="cb-policy-body"><p class="eyebrow">CODEBREW</p>
    <h1>{policy.title || 'Política no encontrada'}</h1>
    {hasContent ? (
      <div class="policy-body">
        {policy.body.split('\n\n').map(paragraph => (
          <p>{paragraph.split('\n').map((line, i) => (i === 0 ? line : <><br />{line}</>))}</p>
        ))}
      </div>
    ) : (
      <p class="muted">Aún no publicamos el texto de esta política. Escríbenos por WhatsApp si tienes dudas mientras tanto.</p>
    )}
  </article></main>
<Footer />
</Layout>
<style>
  .policy-page{max-width:1240px}
  .policy-body p{margin:0 0 20px;line-height:1.7;font-size:15px}
  .policy-body p:first-child{font-weight:600}
</style>
