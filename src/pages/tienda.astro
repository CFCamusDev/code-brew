---
import Layout from '../layouts/Layout.astro';
import Header from '../ui/Header.astro';
import Footer from '../ui/Footer.astro';
import LineSection from '../lines/LineSection.astro';
import { listPublicLineSlugs, findPublicLineProducts } from '../server/modules/catalog';
import { fromCatalog } from '../features/catalog/page-catalog';
export const prerender = false;
const lines = (await Promise.all((await listPublicLineSlugs()).map(slug => findPublicLineProducts(slug)))).filter(line => line !== null);
---
<Layout title="Tienda — CodeBrew"><Header /><main id="main-content"><div class="cb-wrap" style="padding-top:120px"><h1>Nuestras líneas de café</h1>{!lines.length && <p>Pronto encontrarás aquí nuestras próximas líneas.</p>}</div>{lines.map(line => <LineSection line={line.line} products={line.products.map(fromCatalog)} />)}</main><Footer /></Layout>
