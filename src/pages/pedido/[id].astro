---
import Footer from '../../ui/Footer.astro';
import Layout from '../../layouts/Layout.astro';
import ShopHeader from '../../ui/ShopHeader.astro';
import OrderDetail from '../../features/order/OrderDetail.astro';
import { getOrder, isOrderId } from '../../lib/server/shop';
import { formatDateTime, formatOrderNumber, formatPEN } from '../../lib/shop/format';
import { getWhatsAppUrl } from '../../data/config';
import { findPendingPaymentCode, getPaymentGateway } from '../../server/modules/payments';
import '../../styles/shop.css';

export const prerender = false;

const { id } = Astro.params;
const order = isOrderId(id) ? await getOrder(id) : undefined;
if (!order) return new Response('Pedido no encontrado', { status: 404 });

Astro.response.headers.set('Cache-Control', 'no-store');
const number = formatOrderNumber(order.number);
const whatsapp = await getWhatsAppUrl(`¡Hola CodeBrew! Acabo de registrar el pedido ${number} por ${formatPEN(order.totalCents)}. ¿Cómo completo el pago?`);
// CIP vigente de un pago por orden: el cliente puede volver a esta página y pagarlo sin abrir otra vez Culqi.
const pendingCode = order.status === 'pending' ? await findPendingPaymentCode(order.id).catch(() => null) : null;
const pendingPayment = pendingCode && { ...pendingCode, expiresLabel: formatDateTime(pendingCode.expiresAt) };
---
<Layout title={`Pedido ${number} — CodeBrew`} description="Resumen de tu pedido CodeBrew." noindex>
  <ShopHeader />
  <OrderDetail order={order} whatsappUrl={whatsapp} culqiEnabled={getPaymentGateway().isEnabled()} pendingPayment={pendingPayment} />
<Footer />
</Layout>
