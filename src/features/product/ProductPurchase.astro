---
import catalog from '../../data/catalog.json';
import { getLiveCatalog } from '../../lib/server/shop';
import { getWhatsAppBaseUrl, getWhatsAppUrl } from '../../data/config';
interface Props { catalogSlug: string; productName: string; }
const { catalogSlug, productName } = Astro.props;
const live = await getLiveCatalog();
const fallback = catalog.products.find(p=>p.slug===catalogSlug);
const known = fallback?.variants ?? [];
// Existing catalog identities remain unchanged. New Pipeline releases use their own catalog slug/SKUs.
const base = known.length ? known : [...(live?.variants.keys() ?? [])].filter(sku=>sku.startsWith(catalogSlug+'-') && /-(250|500)$/.test(sku)).map(sku=>({sku,format:sku.endsWith('-500')?'500 g':'250 g',price:live!.variants.get(sku)!.price}));
const variants = base.map(v=>({...v,price:live?.variants.get(v.sku)?.price ?? v.price,available:live ? live.variants.get(v.sku)?.available ?? false : true}));
const first = variants.find(v=>v.available) ?? variants[0];
const grinds = live?.grinds.get(catalogSlug) ?? fallback?.grinds ?? [];
---
{first && grinds.length ? <article id={'blend-'+catalogSlug} class="blend-panel cb-purchase" data-profile={catalogSlug} data-product={productName}>
 <div class="product-options"><label>Presentación<select class="variant-select" aria-label={'Presentación de '+productName}>{variants.map(v=><option value={v.format} data-price={v.price} data-sku={v.sku} data-available={String(v.available)} selected={v===first}>{v.format}</option>)}</select></label><label>Molienda<select class="grind-select" aria-label={'Molienda de '+productName}>{grinds.map(g=><option>{g}</option>)}</select></label></div>
 <div class="cb-purchase-total"><span class="product-price">S/ {first.price.toFixed(2)}</span></div>
 <p class="reserve-note" hidden={first.available}>Nuevo lote en camino · Resérvalo y te avisamos apenas esté listo.</p>
 <button type="button" class:list={['button primary order-link add-to-cart',{'is-reserve':!first.available}]}>{first.available?'Este es mi café ':'Reservar mi café '}<span aria-hidden="true">{first.available?'+':'→'}</span></button>
 <a class="order-alt whatsapp-order" target="_blank" rel="noopener noreferrer" href={await getWhatsAppUrl('¡Hola CodeBrew! Quiero pedir '+productName+' ('+first.format+'), '+grinds[0]+', por S/ '+first.price+'. ¿Me confirman disponibilidad y envío?')}>o pídelo por WhatsApp ↗</a>
</article> : <p class="cb-catalog-unavailable" role="status">Este perfil todavía no tiene presentaciones disponibles en el catálogo.</p>}
  <dialog class="reserve-dialog" aria-labelledby="reserve-title" data-whatsapp={await getWhatsAppBaseUrl()}>
    <form class="reserve-form" novalidate>
      <button type="button" class="reserve-close" aria-label="Cerrar">×</button>
      <p class="eyebrow">NUEVO LOTE EN CAMINO</p>
      <h3 id="reserve-title">Reserva tu café</h3>
      <p class="reserve-intro">Estamos empacando el próximo lote. Déjanos tus datos y te escribimos por WhatsApp apenas esté listo. No pagas nada ahora.</p>
      <p class="reserve-item"></p>
      <div class="reserve-fields">
        <label>Cantidad<input name="qty" type="number" min="1" max="10" value="1" inputmode="numeric" required /></label>
        <label>Celular<input name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="9XX XXX XXX" required /></label>
        <label class="reserve-wide">Nombre<input name="name" autocomplete="name" maxlength="60" required /></label>
        <label class="reserve-wide">Distrito o ciudad<input name="place" autocomplete="address-level2" maxlength="60" placeholder="Ej. Miraflores, Lima" required /></label>
        <label class="reserve-wide"><span>Comentario <small>(opcional)</small></span><textarea name="note" rows="2" maxlength="200"></textarea></label>
      </div>
      <p class="reserve-error" role="alert" hidden></p>
      <button type="submit" class="button primary">Enviar reserva por WhatsApp <span aria-hidden="true">↗</span></button>
      <p class="reserve-fine">Se abrirá WhatsApp con tu mensaje listo; solo tienes que enviarlo.</p>
    </form>
  </dialog>
<script>
 import { track } from '../../lib/analytics';
 import { addToCart, cartOpen } from '../cart/cart';
  document.querySelectorAll<HTMLElement>('.blend-panel[data-product]').forEach(card=>{
    const variant=card.querySelector<HTMLSelectElement>('.variant-select')!;
    const grind=card.querySelector<HTMLSelectElement>('.grind-select')!;
    const link=card.querySelector<HTMLAnchorElement>('.whatsapp-order')!;
    const add=card.querySelector<HTMLButtonElement>('.add-to-cart')!;
    const note=card.querySelector<HTMLElement>('.reserve-note')!;
    const update=()=>{const available=variant.selectedOptions[0].dataset.available!=='false';add.classList.toggle('is-reserve',!available);note.hidden=available;add.firstChild!.textContent=available?'Este es mi café ':'Reservar mi café ';add.querySelector('span')!.textContent=available?'+':'→';const price=Number(variant.selectedOptions[0].dataset.price);card.querySelector('.product-price')!.textContent=`S/ ${price.toFixed(2)}`;const url=new URL(link.href);url.searchParams.set('text',`¡Hola CodeBrew! Quiero pedir ${card.dataset.product} (${variant.value}), ${grind.value}, por S/ ${price}. ¿Me confirman disponibilidad y envío?`);link.href=url.toString();};
    const view = () => {
      const option = variant.selectedOptions[0];
      track('view_item', {value:Number(option.dataset.price),items:[{item_id:option.dataset.sku!,item_name:card.dataset.product!,price:Number(option.dataset.price),quantity:1}]});
    };
    let seen = '';
    const observer = new IntersectionObserver(entries => {
      if(entries.some(e=>e.isIntersecting) && !card.hidden && seen !== variant.value) { seen=variant.value; view(); }
    }, {threshold:.4});
    observer.observe(card);
    variant.addEventListener('change',()=>{if(!card.hidden){seen=variant.value;view();}});
    variant.addEventListener('change',update);grind.addEventListener('change',update);
    add.addEventListener('click',()=>{
      const option=variant.selectedOptions[0];
      if(option.dataset.available==='false') return openReserve({product:card.dataset.product!,format:variant.value,grind:grind.value,price:Number(option.dataset.price)});
      addToCart(option.dataset.sku!,grind.value,1,Number(option.dataset.price));cartOpen.set(true);
    });
  });

  // Reserva por WhatsApp: mientras llega el nuevo lote, el cliente deja sus datos y se abre el chat con el mensaje listo.
  const reserveDialog=document.querySelector<HTMLDialogElement>('.reserve-dialog')!;
  const reserveForm=reserveDialog.querySelector<HTMLFormElement>('form')!;
  const reserveError=reserveDialog.querySelector<HTMLElement>('.reserve-error')!;
  let reserving={product:'',format:'',grind:'',price:0};
  function openReserve(item: typeof reserving){
    reserving=item;
    reserveDialog.querySelector('.reserve-item')!.textContent=`${item.product} · ${item.format} · ${item.grind} · S/ ${item.price.toFixed(2)} c/u`;
    reserveError.hidden=true;
    reserveDialog.showModal();
  }
  reserveDialog.querySelector('.reserve-close')!.addEventListener('click',()=>reserveDialog.close());
  // Un clic fuera de la tarjeta (sobre el fondo) también la cierra.
  reserveDialog.addEventListener('click',event=>{if(event.target===reserveDialog)reserveDialog.close();});
  reserveForm.addEventListener('submit',event=>{
    event.preventDefault();
    const data=new FormData(reserveForm);
    const value=(key:string)=>String(data.get(key)??'').trim();
    const qty=Number(value('qty'));
    // Celular peruano: 9 dígitos que empiezan con 9 (se aceptan espacios y el prefijo 51).
    const phone=value('phone').replace(/\D/g,'').replace(/^51(?=9\d{8}$)/,'');
    const problem=!Number.isInteger(qty)||qty<1||qty>10?'La cantidad debe ser de 1 a 10 bolsas.'
      :!/^9\d{8}$/.test(phone)?'Escribe un celular de 9 dígitos que empiece con 9.'
      :value('name').length<2?'Escribe tu nombre.'
      :value('place').length<2?'Escribe tu distrito o ciudad.':'';
    reserveError.textContent=problem;reserveError.hidden=!problem;
    if(problem) return;
    const lines=[
      '¡Hola CodeBrew! Quiero reservar mi café del nuevo lote:',
      `• ${qty} × ${reserving.product} ${reserving.format}, ${reserving.grind} (S/ ${reserving.price.toFixed(2)} c/u)`,
      `• Nombre: ${value('name')}`,
      `• Celular: ${phone}`,
      `• Entrega en: ${value('place')}`,
      ...(value('note')?[`• Comentario: ${value('note')}`]:[]),
      'Avísenme apenas esté listo. ¡Gracias!'
    ];
    window.open(`${reserveDialog.dataset.whatsapp}?text=${encodeURIComponent(lines.join('\n'))}`,'_blank','noopener');
    reserveForm.querySelector<HTMLTextAreaElement>('textarea')!.value='';
    reserveDialog.close();
  });

</script>
