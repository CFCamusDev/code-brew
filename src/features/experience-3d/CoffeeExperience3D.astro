---
---

<div class="scrolly-3d-container" id="scrolly3DContainer" aria-hidden="true">
  <canvas id="scrollyCanvas3D" class="scrolly-canvas-3d"></canvas>
  <div class="scrolly-ambient-light" id="scrollyAmbientLight"></div>
</div>

<style>
  .scrolly-3d-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 1; /* Por encima del fondo pero por debajo de los textos y botones interactivos */
    overflow: hidden;
  }

  .scrolly-canvas-3d {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: block;
    outline: none;
  }

  .scrolly-ambient-light {
    position: absolute;
    width: 700px;
    height: 700px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(200, 137, 74, 0.12) 0%, rgba(127, 214, 155, 0.04) 45%, transparent 70%);
    pointer-events: none;
    transform: translate(-50%, -50%);
    opacity: 0.85;
    transition: opacity 0.4s ease;
    mix-blend-mode: screen;
  }
</style>

<script>
  import * as THREE from 'three';

  function initScrolly3D() {
    const container = document.getElementById('scrolly3DContainer');
    const canvas = document.getElementById('scrollyCanvas3D') as HTMLCanvasElement;
    const ambientLightDiv = document.getElementById('scrollyAmbientLight');
    if (!container || !canvas) return;

    let width = window.innerWidth;
    let height = window.innerHeight;
    let isMobile = width < 900;

    // 1. Escena & Cámara
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 100);
    camera.position.set(0, 0, 10);

    // 2. Renderer WebGL de alto impacto
    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
      powerPreference: 'high-performance'
    });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, isMobile ? 1.35 : 1.75));
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.35;

    // 3. Sistema de Iluminación Cinemática
    const ambientLight = new THREE.AmbientLight(0x12131A, 1.8);
    scene.add(ambientLight);

    // Luz principal de estudio (Key light)
    const keyLight = new THREE.DirectionalLight(0xfff6ec, 3.2);
    keyLight.position.set(4, 5, 6);
    scene.add(keyLight);

    // Luz de relleno fría (Fill light)
    const fillLight = new THREE.DirectionalLight(0x283248, 1.5);
    fillLight.position.set(-5, 1, 4);
    scene.add(fillLight);

    // Rim Light Cobre (Marca CodeBrew)
    const copperRim = new THREE.DirectionalLight(0xC8894A, 5.0);
    copperRim.position.set(-4, -3, -2);
    scene.add(copperRim);

    // Rim Light Verde Terminal (Detalles Tech)
    const terminalLight = new THREE.PointLight(0x7FD69B, 3.5, 18);
    terminalLight.position.set(3, 4, -3);
    scene.add(terminalLight);

    // 4. Carga de Texturas PBR
    const textureLoader = new THREE.TextureLoader();
    const pouchTexture = textureLoader.load('/assets/3d/pouch-texture.png');
    pouchTexture.colorSpace = THREE.SRGBColorSpace;

    const roughnessTexture = textureLoader.load('/assets/3d/roughness-surface.png');
    roughnessTexture.wrapS = THREE.RepeatWrapping;
    roughnessTexture.wrapT = THREE.RepeatWrapping;
    roughnessTexture.repeat.set(1.5, 1.5);

    const beanTexture = textureLoader.load('/assets/3d/coffee-bean.png');
    beanTexture.colorSpace = THREE.SRGBColorSpace;

    // 5. Modelado Procedural de la Gran Bolsa de Café (Stand-Up Pouch)
    // Se construye con BufferGeometry customizada para un sellado superior realista
    const bagWidth = 2.5;
    const bagHeight = 3.8;
    const bagDepth = 1.0;

    // --- Cuerpo principal de la bolsa (sin la tapa superior) ---
    const bagGeom = new THREE.BoxGeometry(bagWidth, bagHeight, bagDepth, 40, 60, 18);

    const pos = bagGeom.attributes.position;

    // Zona donde comienza el sellado (normalizada -1 a 1)
    const sealStart = 0.82;
    // Zona de transición suave
    const sealTransition = 0.06;

    for (let i = 0; i < pos.count; i++) {
      let x = pos.getX(i);
      let y = pos.getY(i);
      let z = pos.getZ(i);

      const ny = y / (bagHeight / 2); // de -1 a 1

      // --- SELLADO SUPERIOR: Pinch suave tipo aleta real ---
      if (ny > sealStart) {
        const t = Math.min(1.0, (ny - sealStart) / (1.0 - sealStart));
        // Easing más suave (quintic ease-in-out)
        const smoothT = t * t * t * (t * (t * 6 - 15) + 10);

        // El depth (Z) se cierra progresivamente
        z = z * (1.0 - smoothT * 0.88);

        // Los lados se estrechan un poco
        x = x * (1.0 - smoothT * 0.04);
      }

      // --- TRANSICIÓN SUAVE al sello ---
      if (ny > (sealStart - sealTransition) && ny <= sealStart) {
        const blendT = (ny - (sealStart - sealTransition)) / sealTransition;
        const smoothBlend = blendT * blendT * (3 - 2 * blendT);
        z = z * (1.0 - smoothBlend * 0.12);
      }

      // --- INFLADO del contenido de café (belly) ---
      if (ny > -0.75 && ny <= sealStart - sealTransition) {
        const belly = Math.cos((ny + 0.1) * Math.PI * 0.55);
        z *= 1.0 + Math.max(0, belly) * 0.42;
      }

      // --- FUELLES laterales cóncavos ---
      const absX = Math.abs(x);
      if (absX > bagWidth * 0.38 && ny < sealStart) {
        const inward = (absX - bagWidth * 0.38) / (bagWidth * 0.12);
        const centerZ = 1.0 - Math.min(1.0, Math.abs(z) / (bagDepth * 0.5));
        x -= Math.sign(x) * inward * centerZ * 0.08;
      }

      // --- BASE estable y ancha ---
      if (ny < -0.8) {
        const b = (ny + 0.8) / -0.2;
        z *= 1.0 + b * 0.18;
      }

      pos.setXYZ(i, x, y, z);
    }
    bagGeom.computeVertexNormals();

    // --- Suavizar normales en la zona del sello ---
    // BoxGeometry tiene vértices duplicados en los bordes con normales diferentes,
    // lo que causa aristas duras visibles. Fusionamos las normales de vértices
    // coincidentes en la zona superior para suavizar la transición.
    const normals = bagGeom.attributes.normal;
    const mergeThreshold = 0.001;
    const sealNormalStart = (sealStart - sealTransition - 0.05) * (bagHeight / 2);

    // Construir mapa de vértices coincidentes en la zona de sello
    const vertexMap: Map<string, number[]> = new Map();
    for (let i = 0; i < pos.count; i++) {
      const py = pos.getY(i);
      if (py < sealNormalStart) continue;

      const key = `${Math.round(pos.getX(i) / mergeThreshold)}_${Math.round(py / mergeThreshold)}_${Math.round(pos.getZ(i) / mergeThreshold)}`;
      if (!vertexMap.has(key)) vertexMap.set(key, []);
      vertexMap.get(key)!.push(i);
    }

    // Promediar normales de vértices coincidentes
    for (const indices of vertexMap.values()) {
      if (indices.length <= 1) continue;
      let nx = 0, ny2 = 0, nz = 0;
      for (const idx of indices) {
        nx += normals.getX(idx);
        ny2 += normals.getY(idx);
        nz += normals.getZ(idx);
      }
      const len = Math.sqrt(nx * nx + ny2 * ny2 + nz * nz) || 1;
      nx /= len; ny2 /= len; nz /= len;
      for (const idx of indices) {
        normals.setXYZ(idx, nx, ny2, nz);
      }
    }

    // --- Materiales ---
    const frontMaterial = new THREE.MeshPhysicalMaterial({
      map: pouchTexture,
      roughnessMap: roughnessTexture,
      roughness: 0.36,
      metalness: 0.14,
      clearcoat: 0.28,
      clearcoatRoughness: 0.25,
      reflectivity: 0.6
    });

    const sideMaterial = new THREE.MeshPhysicalMaterial({
      color: 0x101115,
      roughnessMap: roughnessTexture,
      roughness: 0.48,
      metalness: 0.2,
      clearcoat: 0.15
    });

    // BoxGeometry face order: +X, -X, +Y, -Y, +Z, -Z
    const bagMaterials = [
      sideMaterial,   // +X (lado derecho)
      sideMaterial,   // -X (lado izquierdo)
      sideMaterial,   // +Y (tapa superior - mismo material que lados)
      sideMaterial,   // -Y (base)
      frontMaterial,  // +Z (frente - con textura)
      sideMaterial    // -Z (atrás)
    ];

    // Grupo para la bolsa completa
    const bagGroup = new THREE.Group();

    const bagMesh = new THREE.Mesh(bagGeom, bagMaterials);
    bagGroup.add(bagMesh);

    bagGroup.scale.setScalar(1.22);
    scene.add(bagGroup);

    // 6. Anillos Holográficos de Telemetría (Cyber Orbit Rings sutiles de precisión)
    const ringGeom1 = new THREE.TorusGeometry(isMobile ? 1.3 : 1.65, 0.007, 16, 72);
    const ringMat1 = new THREE.MeshBasicMaterial({
      color: 0xC8894A,
      transparent: true,
      opacity: isMobile ? 0.2 : 0.35
    });
    const ring1 = new THREE.Mesh(ringGeom1, ringMat1);
    ring1.rotation.x = Math.PI / 3;
    scene.add(ring1);

    const ringGeom2 = new THREE.TorusGeometry(isMobile ? 1.5 : 1.85, 0.006, 16, 72);
    const ringMat2 = new THREE.MeshBasicMaterial({
      color: 0x7FD69B,
      transparent: true,
      opacity: isMobile ? 0.15 : 0.28
    });
    const ring2 = new THREE.Mesh(ringGeom2, ringMat2);
    ring2.rotation.y = Math.PI / 4;
    scene.add(ring2);

    // 7. Modelado del Grano de Café (Coffee Bean Geometry)
    function makeBeanGeometry(): THREE.BufferGeometry {
      const geom = new THREE.SphereGeometry(0.5, 32, 32);
      const bPos = geom.attributes.position;
      for (let i = 0; i < bPos.count; i++) {
        let bx = bPos.getX(i) * 0.78;
        let by = bPos.getY(i) * 1.32;
        let bz = bPos.getZ(i) * 0.64;
        if (bz > 0) {
          const depth = Math.exp(-Math.pow(Math.abs(bx) / 0.12, 2));
          bz -= depth * 0.25;
        }
        bPos.setXYZ(i, bx, by, bz);
      }
      geom.computeVertexNormals();
      return geom;
    }

    const beanGeom = makeBeanGeometry();
    const beanMat = new THREE.MeshPhysicalMaterial({
      map: beanTexture,
      color: 0x543218,
      roughness: 0.5,
      metalness: 0.1,
      clearcoat: 0.25
    });

    // Granos Satelitales elegantes en órbita cerrada alrededor de la bolsa
    interface SatBean {
      mesh: THREE.Mesh;
      orbitRadius: number;
      orbitSpeed: number;
      orbitAngle: number;
      orbitHeight: number;
      rotSpeedX: number;
      rotSpeedY: number;
    }

    const satBeans: SatBean[] = [];
    const numBeans = isMobile ? 3 : 5;
    for (let i = 0; i < numBeans; i++) {
      const b = new THREE.Mesh(beanGeom, beanMat);
      const s = isMobile ? (0.28 + Math.random() * 0.15) : (0.38 + Math.random() * 0.18);
      b.scale.setScalar(s);
      scene.add(b);

      satBeans.push({
        mesh: b,
        orbitRadius: (isMobile ? 1.3 : 1.7) + Math.random() * (isMobile ? 0.4 : 0.6),
        orbitSpeed: 0.3 + Math.random() * 0.25,
        orbitAngle: (i / numBeans) * Math.PI * 2,
        orbitHeight: (Math.random() - 0.5) * (isMobile ? 1.2 : 2.0),
        rotSpeedX: (Math.random() - 0.5) * 0.02,
        rotSpeedY: (Math.random() - 0.5) * 0.02
      });
    }

    // 8. Textura Circular Suave para Partículas (Evita artefactos cuadrados)
    function createCircleTexture(): THREE.CanvasTexture {
      const pCanvas = document.createElement('canvas');
      pCanvas.width = 32;
      pCanvas.height = 32;
      const ctx = pCanvas.getContext('2d')!;
      const grad = ctx.createRadialGradient(16, 16, 0, 16, 16, 16);
      grad.addColorStop(0, 'rgba(255, 255, 255, 1)');
      grad.addColorStop(0.35, 'rgba(255, 255, 255, 0.7)');
      grad.addColorStop(1, 'rgba(255, 255, 255, 0)');
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, 32, 32);
      return new THREE.CanvasTexture(pCanvas);
    }

    const circleTex = createCircleTexture();

    const particleCount = isMobile ? 60 : 130;
    const pGeom = new THREE.BufferGeometry();
    const pPos = new Float32Array(particleCount * 3);
    const pColor = new Float32Array(particleCount * 3);
    const c1 = new THREE.Color(0xC8894A);
    const c2 = new THREE.Color(0x7FD69B);

    for (let i = 0; i < particleCount; i++) {
      pPos[i * 3] = (Math.random() - 0.5) * 20;
      pPos[i * 3 + 1] = (Math.random() - 0.5) * 30;
      pPos[i * 3 + 2] = (Math.random() - 0.5) * 12;

      const col = Math.random() > 0.55 ? c1 : c2;
      pColor[i * 3] = col.r;
      pColor[i * 3 + 1] = col.g;
      pColor[i * 3 + 2] = col.b;
    }

    pGeom.setAttribute('position', new THREE.BufferAttribute(pPos, 3));
    pGeom.setAttribute('color', new THREE.BufferAttribute(pColor, 3));

    const pMat = new THREE.PointsMaterial({
      size: isMobile ? 0.09 : 0.13,
      map: circleTex,
      vertexColors: true,
      transparent: true,
      opacity: isMobile ? 0.35 : 0.6,
      blending: THREE.AdditiveBlending,
      depthWrite: false
    });
    const particles = new THREE.Points(pGeom, pMat);
    scene.add(particles);

    // 9. Coreografía Cinemática Scrollytelling Adaptada al Contenido y Marca
    function getKeyframes(mobile: boolean) {
      return [
        // 0.0: HERO - Bolsa perfectamente encuadrada en el marco derecho del Hero
        {
          progress: 0.0,
          bagPos: mobile ? [0, 1.0, -1.2] : [2.35, -0.15, 1.3],
          bagRot: [0.05, -0.24, 0.01],
          bagScale: mobile ? 0.72 : 1.18,
          lightColor: 0xC8894A
        },
        // 0.22: ORIGEN - Bolsa viaja a la columna derecha acompañando la topografía de Amazonas
        {
          progress: 0.22,
          bagPos: mobile ? [0, 0.1, -1.6] : [2.5, -0.12, 1.05],
          bagRot: [0.1, 0.45, -0.04],
          bagScale: mobile ? 0.68 : 1.14,
          lightColor: 0x7FD69B
        },
        // 0.48: PRODUCTOS - Bolsa asciende al lateral superior derecho como empaque insignia
        {
          progress: 0.48,
          bagPos: mobile ? [0, 1.2, -2.0] : [3.4, 1.6, 0.1],
          bagRot: [-0.06, -0.7, 0.04],
          bagScale: mobile ? 0.62 : 0.95,
          lightColor: 0xC8894A
        },
        // 0.72: FEATURES & SCA CUPPING - Bolsa orientada hacia la telemetría de cata
        {
          progress: 0.72,
          bagPos: mobile ? [0, -0.3, -1.8] : [2.65, -0.08, 0.95],
          bagRot: [0.18, 0.35, 0.05],
          bagScale: mobile ? 0.68 : 1.1,
          lightColor: 0x7FD69B
        },
        // 1.0: FINAL CTA - Trofeo cenital suspendido sobre el pedestal del CTA
        {
          progress: 1.0,
          bagPos: mobile ? [0, 1.6, -0.4] : [0, 2.1, 1.3],
          bagRot: [0.04, Math.PI * 2, 0],
          bagScale: mobile ? 0.82 : 1.28,
          lightColor: 0xC8894A
        }
      ];
    }

    let activeKeyframes = getKeyframes(isMobile);

    function interpolateKeyframes(p: number) {
      if (p <= activeKeyframes[0].progress) return activeKeyframes[0];
      if (p >= activeKeyframes[activeKeyframes.length - 1].progress) return activeKeyframes[activeKeyframes.length - 1];

      for (let i = 0; i < activeKeyframes.length - 1; i++) {
        const k1 = activeKeyframes[i];
        const k2 = activeKeyframes[i + 1];
        if (p >= k1.progress && p <= k2.progress) {
          const t = (p - k1.progress) / (k2.progress - k1.progress);
          // Easing suave (smoothstep)
          const easeT = t * t * (3 - 2 * t);

          return {
            bagPos: [
              k1.bagPos[0] + (k2.bagPos[0] - k1.bagPos[0]) * easeT,
              k1.bagPos[1] + (k2.bagPos[1] - k1.bagPos[1]) * easeT,
              k1.bagPos[2] + (k2.bagPos[2] - k1.bagPos[2]) * easeT
            ],
            bagRot: [
              k1.bagRot[0] + (k2.bagRot[0] - k1.bagRot[0]) * easeT,
              k1.bagRot[1] + (k2.bagRot[1] - k1.bagRot[1]) * easeT,
              k1.bagRot[2] + (k2.bagRot[2] - k1.bagRot[2]) * easeT
            ],
            bagScale: k1.bagScale + (k2.bagScale - k1.bagScale) * easeT,
            lightColor: k1.lightColor
          };
        }
      }
      return activeKeyframes[0];
    }

    // 10. Control de Scroll y Mouse
    let targetProgress = 0;
    let currentProgress = 0;
    let targetMouseX = 0;
    let targetMouseY = 0;
    let currentMouseX = 0;
    let currentMouseY = 0;

    function onScroll() {
      const scrollY = window.scrollY;
      const maxScroll = Math.max(1, document.body.scrollHeight - window.innerHeight);
      targetProgress = Math.min(1, Math.max(0, scrollY / maxScroll));
    }

    window.addEventListener('scroll', onScroll, { passive: true });

    window.addEventListener('pointermove', (e) => {
      targetMouseX = (e.clientX / window.innerWidth - 0.5) * 2;
      targetMouseY = (e.clientY / window.innerHeight - 0.5) * 2;

      if (ambientLightDiv) {
        ambientLightDiv.style.left = `${e.clientX}px`;
        ambientLightDiv.style.top = `${e.clientY}px`;
      }
    }, { passive: true });

    // 11. Bucle de Renderizado Scrollytelling a 60fps
    let clock = new THREE.Clock();

    function animate() {
      requestAnimationFrame(animate);

      const elapsed = clock.getElapsedTime();

      // Suavizado lerp inercial
      currentProgress += (targetProgress - currentProgress) * 0.085;
      currentMouseX += (targetMouseX - currentMouseX) * 0.05;
      currentMouseY += (targetMouseY - currentMouseY) * 0.05;

      const state = interpolateKeyframes(currentProgress);

      // Flotación senoidal de levitación física
      const floatY = Math.sin(elapsed * 1.5) * 0.08;
      const floatRotZ = Math.sin(elapsed * 1.1) * 0.02;

      // Transformación de la Gran Bolsa de Café 3D
      bagGroup.position.x = state.bagPos[0] + currentMouseX * 0.35;
      bagGroup.position.y = state.bagPos[1] + floatY - currentMouseY * 0.25;
      bagGroup.position.z = state.bagPos[2];

      bagGroup.rotation.x = state.bagRot[0] - currentMouseY * 0.25;
      bagGroup.rotation.y = state.bagRot[1] + currentMouseX * 0.35;
      bagGroup.rotation.z = state.bagRot[2] + floatRotZ;

      bagGroup.scale.setScalar(state.bagScale);

      // Anillos holográficos que giran alrededor de la bolsa
      ring1.position.copy(bagGroup.position);
      ring1.rotation.z = elapsed * 0.4;
      ring1.rotation.y = elapsed * 0.25;

      ring2.position.copy(bagGroup.position);
      ring2.rotation.x = elapsed * 0.3;
      ring2.rotation.z = -elapsed * 0.35;

      // Granos satelitales en órbita alrededor de la bolsa de café
      satBeans.forEach((sb) => {
        const angle = sb.orbitAngle + elapsed * sb.orbitSpeed;
        sb.mesh.position.x = bagGroup.position.x + Math.cos(angle) * sb.orbitRadius;
        sb.mesh.position.z = bagGroup.position.z + Math.sin(angle) * sb.orbitRadius;
        sb.mesh.position.y = bagGroup.position.y + sb.orbitHeight + Math.sin(elapsed * 1.3 + sb.orbitRadius) * 0.2;

        sb.mesh.rotation.x += sb.rotSpeedX;
        sb.mesh.rotation.y += sb.rotSpeedY;
      });

      // Ondulación del polvo de partículas
      particles.rotation.y = elapsed * 0.03 + currentMouseX * 0.04;

      renderer.render(scene, camera);
    }

    animate();

    // 12. Responsive Resize
    window.addEventListener('resize', () => {
      width = window.innerWidth;
      height = window.innerHeight;
      isMobile = width < 900;
      activeKeyframes = getKeyframes(isMobile);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, isMobile ? 1.35 : 1.75));
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScrolly3D);
  } else {
    initScrolly3D();
  }
</script>
