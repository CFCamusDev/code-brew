---
import { Image } from 'astro:assets';
import fallback from '../../assets/demo/monteverde.png';
interface Props { kind: 'hero' | 'origin' | 'ritual' | 'team'; label: string; }
const {kind, label} = Astro.props;
---
<div class={`world-stage world-${kind}`} data-world={kind === 'ritual' ? undefined : kind} role="img" aria-label={kind === 'ritual' ? 'Taza verde Codebrew con capuchino, espuma y plato a juego' : label}>
  <div class="world-halo" aria-hidden="true"></div>
  {kind === 'hero'
    ? <div class="world-fallback hero-package-preview" aria-hidden="true">
        <img src="/assets/brand/hotfix-stable-front.webp" alt="" width="1249" height="2048" loading="eager" fetchpriority="high" />
        <span class="preview-side"></span>
      </div>
    : kind === 'ritual'
      ? <img class="ritual-cup-photo" src="/assets/brand/cappuccino-cup.webp" width="1100" height="1100" alt="" loading="lazy" decoding="async" />
      : kind === 'team' ? <img class="world-fallback" src="/assets/brand/hotfix-stable-front.webp" alt="Empaque Codebrew Hotfix" width="1249" height="2048" loading="lazy" /> : <Image class="world-fallback" src={fallback} alt="Empaque conceptual CodeBrew" width={768} height={1152} format="webp" loading="lazy" />}
  <div class="world-cross cross-one" aria-hidden="true">+</div><div class="world-cross cross-two" aria-hidden="true">+</div>
  {kind === 'hero' && <><span class="world-coordinate">EST. EN PERÚ<br />6° S / 77° O</span><span class="world-stamp">CAFÉ DE ORIGEN<br /><strong>PE</strong><br />ESPÍRITU DEVELOPER</span><span class="world-note">UN BUEN ORIGEN.<br />INFINITAS POSIBILIDADES.</span></>}
  {kind === 'origin' && <span class="world-coordinate">ORIGEN / AMAZONAS<br />RELIEVE INTERPRETATIVO</span>}
  {kind === 'ritual' && <span class="world-coordinate">BREW. BUILD. REPEAT.<br />// ONE CUP AT A TIME</span>}
</div>
