<div class="ritual-player" data-ritual-player>
  <video muted loop playsinline preload="metadata" poster="/assets/brand/ritual-v60-poster.jpg" aria-label="Preparación de café de especialidad con método V60" disablepictureinpicture disableremoteplayback>
    <source src="/assets/brand/ritual-v60.mp4" type="video/mp4" />
  </video>
  <span class="image-label">// specialty coffee</span>
</div>
<style>
  .ritual-player {position:relative;height:480px;aspect-ratio:9/16;max-width:100%;margin-inline:auto;background:#3a2a1e;overflow:hidden;isolation:isolate;}
  /* El video ocupa toda la tarjeta: es vertical 9:16, igual que el reproductor. */
  video {position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}
  .image-label {z-index:2;background:#f4f1e9c9;}
  @media(max-width:700px){.ritual-player{height:480px;max-height:75svh;}}
</style>
<script>
  // Repite el video V60 en bucle solo mientras se ve; con «reducir movimiento» queda la imagen fija.
  const host = document.querySelector<HTMLElement>('[data-ritual-player]');
  const video = host?.querySelector('video');
  if (host && video) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let visible = false;
    const active = () => visible && !document.hidden && !reduced.matches && !document.documentElement.classList.contains('motion-paused');
    const sync = () => {
      if (active()) video.play().catch(() => {});
      else video.pause();
    };
    const observer = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting && entry.intersectionRatio >= .45;
      sync();
    }, {threshold:[0,.45]});
    observer.observe(host);
    document.addEventListener('visibilitychange', sync);
    window.addEventListener('codebrew:motion', sync);
    reduced.addEventListener('change', sync);
    window.addEventListener('pagehide', () => video.pause());
    window.addEventListener('pageshow', sync);
  }
</script>
