PGHOST=codebrew-db
PGPORT=5432
PGUSER=codebrew
PGDATABASE=codebrew
BACKUP_NETWORK=codebrew_default
BACKUP_HOST=codebrew-production
BACKUP_SECRETS_DIR=/etc/codebrew-backups/secrets
RESTIC_REPOSITORY=s3:https://S3_ENDPOINT/BUCKET/codebrew-production
AWS_DEFAULT_REGION=us-east-1
RESTORE_DATABASE=
