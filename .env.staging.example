# Variables para la stack codebrew-staging en Portainer. No es el .env de producción.
# Copiar como .env.staging para Compose local, o cargar sus valores en la stack.
POSTGRES_PASSWORD=
STAGING_SITE_URL=https://staging.coffeecodebrew.com
STAGING_BIND_ADDRESS=127.0.0.1
STAGING_PORT=8026
# Llaves EXCLUSIVAMENTE de prueba. APP_ENV=staging rechaza llaves live al arrancar.
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
CULQI_WEBHOOK_SECRET=
CULQI_WEBHOOK_SECRET_PREVIOUS=
STAGING_CRON_SECRET=
STAGING_DEPLOYMENT_ID=manual
CATALOG_SOURCE=db
# Opcionales y separados de producción. Vacíos: no envía correos ni reporta a Sentry.
STAGING_RESEND_API_KEY=
STAGING_EMAIL_FROM=
STAGING_ADMIN_EMAIL=
STAGING_SENTRY_DSN=
STAGING_CLOUDINARY_CLOUD_NAME=
STAGING_CLOUDINARY_API_KEY=
STAGING_CLOUDINARY_API_SECRET=
