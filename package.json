{
  "name": "code-brew",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --host",
    "start": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview --host",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db/migrate.mjs",
    "db:seed": "node scripts/db/seed.mjs",
    "db:studio": "drizzle-kit studio",
    "admin:create": "node scripts/admin/create-user.mjs",
    "typecheck": "astro sync && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@astrojs/node": "^9.5.5",
    "@astrojs/react": "^4.4.2",
    "@hookform/resolvers": "^6.0.0",
    "@nanostores/persistent": "^1.3.5",
    "@nanostores/react": "^2.0.1",
    "@types/three": "^0.186.0",
    "astro": "^5.4.1",
    "drizzle-orm": "^0.45.4",
    "gsap": "^3.15.0",
    "nanostores": "^1.5.5",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "sharp": "0.34.5",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.11"
  }
}
