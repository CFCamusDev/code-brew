{
  "name": "code-brew",
  "type": "module",
  "version": "1.7.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --host",
    "start": "node dist/server/entry.mjs",
    "build": "astro build",
    "preview": "astro preview --host",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "local:up": "node scripts/local-stack.mjs up",
    "local:url": "node scripts/local-stack.mjs url",
    "local:logs": "node scripts/local-stack.mjs logs",
    "local:down": "node scripts/local-stack.mjs down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db/migrate.mjs",
    "db:seed": "node scripts/db/seed.mjs",
    "db:studio": "drizzle-kit studio",
    "admin:create": "node scripts/admin/create-user.mjs",
    "typecheck": "astro sync && tsc --noEmit",
    "deps:check": "depcruise src/server --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "config:check": "node scripts/validate-env.mjs",
    "test:docker": "node scripts/test-docker.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@astrojs/node": "11.1.9",
    "@astrojs/react": "7.1.1",
    "@hookform/resolvers": "6.0.0",
    "@nanostores/persistent": "1.3.5",
    "@nanostores/react": "2.0.1",
    "@sentry/node": "^11.12.0",
    "astro": "7.4.2",
    "cloudinary": "^2.11.0",
    "drizzle-orm": "0.45.4",
    "gsap": "3.15.0",
    "nanostores": "1.5.5",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "sharp": "0.35.5",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "overrides": {
      "undici@>=8.0.0 <8.12.2": "8.12.2",
      "esbuild@<0.25.0": "0.25.12"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-fc5q-39xc-vjpf"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "dependency-cruiser": "18.7.2",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": "^22.23.4 || ^24.0.0 || >=26.0.0"
  }
}
