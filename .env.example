# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# --- Desarrollo local (base de datos de docker-compose.dev.yml) ---
DATABASE_URL=postgres://codebrew:codebrew@localhost:5434/codebrew

# --- Producción (docker-compose.yml) ---
# Contraseña de PostgreSQL; el compose arma DATABASE_URL con ella.
# Usa un valor aleatorio alfanumérico de al menos 32 caracteres (se interpola en una URL).
POSTGRES_PASSWORD=
# Puerto público en el host donde se expondrá el frontend en Portainer / VPS
PORT=8025

# --- Culqi (CulqiPanel > Desarrollo > API Keys). En desarrollo usa las llaves de prueba ---
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
# Obligatoria al habilitar Culqi: mínimo 32 caracteres aleatorios.
# El webhook se registra como https://<dominio>/api/webhooks/culqi?key=<esta clave>
CULQI_WEBHOOK_SECRET=

# --- Correo (Resend) y URL pública para los enlaces de los correos ---
RESEND_API_KEY=
EMAIL_FROM="CodeBrew <pedidos@tu-dominio.com>"
ADMIN_EMAIL=
# Desarrollo: http://localhost:80 (puerto de Astro). Producción: https://tu-dominio.com
SITE_URL=http://localhost:80

# Token aleatorio de al menos 32 caracteres para tareas programadas. Usar el mismo valor en el secreto CRON_SECRET de GitHub.
CRON_SECRET=

# GA4: build-time. Activar solo para el despliegue real, nunca previews.
PUBLIC_ANALYTICS_ENV=disabled
PUBLIC_GA4_ID=G-YMMJ7V30SZ

# --- Cloudinary (subida de imágenes de producto desde el panel admin) ---
# Seguimiento de errores con Sentry (opcional). Sin DSN queda desactivado. SENTRY_ENVIRONMENT separa producción de pruebas.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Nivel de los logs JSON: debug, info (por defecto), warn o error.
LOG_LEVEL=info

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
